---
---

<!-- SECURITY -->
<section id="security">
  <div class="container">
    <div class="security-grid">
      <div>
        <div class="section-label">Compliance</div>
        <h2 class="section-h2 section-h2--mid display">
          Your clients trust you<br>with what matters most.
        </h2>
        <p class="section-body-lg">
          Your patients share sensitive health information. Every tool we deploy meets HIPAA standards, and every engagement begins with a signed Business Associate Agreement. Not because we have to. Because it's the right starting point.
        </p>
        <p class="cert-badge-label">We only deploy tools certified for:</p>
        <div class="cert-badges">
          <span class="cert-badge mono">HIPAA</span>
          <span class="cert-badge mono">BAA-Ready</span>
          <span class="cert-badge mono">SOC 2</span>
          <span class="cert-badge mono">GDPR</span>
          <span class="cert-badge mono">CCPA</span>
        </div>
      </div>
      <div class="security-features">
        <div class="sec-feature sec-feature--lead">
          <div class="sec-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <div>
            <div class="sec-title">HIPAA by default</div>
            <div class="sec-desc">Every workflow is built BAA-ready before it touches your data. We sign a Business Associate Agreement at the start of every engagement. Your patients' information stays protected. Not as an afterthought. As the foundation.</div>
          </div>
        </div>
        <div class="sec-features-sub">
          <div class="sec-feature">
            <div class="sec-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </div>
            <div>
              <div class="sec-title">Data stays encrypted</div>
              <div class="sec-desc">All client data encrypted at rest and in transit. Built to the standards your compliance officer will ask about.</div>
            </div>
          </div>
          <div class="sec-feature">
            <div class="sec-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </div>
            <div>
              <div class="sec-title">Your data stays yours</div>
              <div class="sec-desc">We never aggregate, sell, or share client data with third parties. What your clients share stays within your organization.</div>
            </div>
          </div>
          <div class="sec-feature">
            <div class="sec-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
            </div>
            <div>
              <div class="sec-title">Every tool vetted</div>
              <div class="sec-desc">Every tool we use has been checked against HIPAA requirements. If it doesn't meet the standard, it doesn't touch your workflows.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- INTEGRATIONS TRUST BAR -->
<section id="integrations">
  <div class="container">
    <div class="integrations-header">
      <div class="section-label">Tools we deploy</div>
      <p class="integrations-note">Every tool here meets HIPAA requirements. We verify compliance before connecting anything to your workflows.</p>
    </div>
    <div class="integrations-grid">
      <div class="integration-item integration-item--lead">
        <div class="integration-name">Retell AI</div>
        <div class="integration-cat">Voice Intake</div>
        <div class="integration-compliance">HIPAA · BAA</div>
      </div>
      <div class="integration-item">
        <div class="integration-name">Epic</div>
        <div class="integration-cat">EHR &amp; Health Records</div>
        <div class="integration-compliance">HIPAA · BAA</div>
      </div>
      <div class="integration-item">
        <div class="integration-name">Google Workspace</div>
        <div class="integration-cat">Email &amp; Collaboration</div>
        <div class="integration-compliance">HIPAA · BAA</div>
      </div>
      <div class="integration-item">
        <div class="integration-name">Microsoft 365</div>
        <div class="integration-cat">Productivity &amp; Communication</div>
        <div class="integration-compliance">HIPAA · BAA</div>
      </div>
      <div class="integration-item">
        <div class="integration-name">DocuSign</div>
        <div class="integration-cat">Electronic Signatures</div>
        <div class="integration-compliance">HIPAA · BAA</div>
      </div>
      <div class="integration-item">
        <div class="integration-name">Salesforce Health Cloud</div>
        <div class="integration-cat">Health CRM</div>
        <div class="integration-compliance">HIPAA · BAA</div>
      </div>
    </div>
  </div>
</section>

<!-- RESULTS EXPECTATION -->
<section id="results-expectation">
  <div class="container">
    <div class="results-inner">
      <div class="section-label">What to expect</div>
      <h2 class="section-h2 display">Here's what you walk away with.</h2>
      <div class="results-body">
        <p>The Capacity Review takes 12 minutes. Alex asks eight questions about how your team operates. Scheduling, intake, reporting, follow-ups, whatever your staff is actually carrying. We review the answers and write your Operations Assessment.</p>
        <p>It arrives within 24 hours. It names your three biggest bottlenecks. It tells you which ones are ready to address now and which ones need more groundwork. It gives you a clear starting point.</p>
        <p>Nothing in it is trying to sell you. It's a document. It belongs to you.</p>
      </div>
    </div>
  </div>
</section>
