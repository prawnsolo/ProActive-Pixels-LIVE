<section id="infrastructure">
  <div class="container">
    <div class="infra-grid">
      <div>
        <div class="section-label">Who We Serve</div>
        <h2 class="section-h2 section-h2--spaced display">
          Built for hard work<br>on tight budgets.
        </h2>
        <p class="section-body-lg">
          We work with a specific set of HIPAA-regulated nonprofits. By the time we talk, we already know where your team is losing hours. The Capacity Review finds exactly how much.
        </p>
        <div class="infra-stats">
          <div>
            <div class="infra-stat-val display">10 hrs</div>
            <div class="infra-stat-label">Reclaimed per week per workflow, on average</div>
          </div>
          <div>
            <div class="infra-stat-val display">24hr</div>
            <div class="infra-stat-label">Your Operations Assessment, no exceptions</div>
          </div>
          <div>
            <div class="infra-stat-val display">100%</div>
            <div class="infra-stat-label">HIPAA-compliant tools, every deployment</div>
          </div>
        </div>
      </div>
      <div>
        <div class="capability-table">
          <div class="cap-header">
            <span class="cap-header-label">Organizations We Serve</span>
            <span class="cap-status"><span class="cap-status-dot"></span>Accepting new clients</span>
          </div>
          <div id="capRows">

            <!-- ── PRIMARY TIER ── -->
            <div class="cap-row cap-row--primary active">
              <div class="cap-row-left">
                <div class="cap-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                </div>
                <div>
                  <div class="cap-name">Free Clinics</div>
                  <div class="cap-sub">Volunteer clinical staff, grant-dependent</div>
                </div>
              </div>
              <div class="cap-badges">
                <div class="cap-badge cap-badge--core">Core</div>
                <div class="cap-badge">HIPAA</div>
              </div>
            </div>

            <div class="cap-row cap-row--primary inactive">
              <div class="cap-row-left">
                <div class="cap-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
                </div>
                <div>
                  <div class="cap-name">Behavioral Health Orgs</div>
                  <div class="cap-sub">Mental health and counseling services</div>
                </div>
              </div>
              <div class="cap-badges">
                <div class="cap-badge cap-badge--core">Core</div>
                <div class="cap-badge">HIPAA</div>
              </div>
            </div>

            <div class="cap-row cap-row--primary inactive">
              <div class="cap-row-left">
                <div class="cap-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                </div>
                <div>
                  <div class="cap-name">Substance Use Treatment</div>
                  <div class="cap-sub">Residential and outpatient programs · 42 CFR Pt. 2</div>
                </div>
              </div>
              <div class="cap-badges">
                <div class="cap-badge cap-badge--core">Core</div>
                <div class="cap-badge">HIPAA</div>
              </div>
            </div>

            <!-- ── TIER DIVIDER ── -->
            <div class="cap-tier-divider">Also serve</div>

            <!-- ── SECONDARY TIER ── -->
            <div class="cap-row cap-row--secondary inactive">
              <div class="cap-row-left">
                <div class="cap-icon cap-icon--dim">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                </div>
                <div>
                  <div class="cap-name">Community Health Centers</div>
                  <div class="cap-sub">Federally funded, HRSA-governed</div>
                </div>
              </div>
              <div class="cap-badges">
                <div class="cap-badge">HIPAA</div>
                <div class="cap-badge">BAA</div>
              </div>
            </div>

            <div class="cap-row cap-row--secondary inactive">
              <div class="cap-row-left">
                <div class="cap-icon cap-icon--dim">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <div>
                  <div class="cap-name">Mental Health Nonprofits</div>
                  <div class="cap-sub">Counseling centers, peer support</div>
                </div>
              </div>
              <div class="cap-badges">
                <div class="cap-badge">HIPAA</div>
              </div>
            </div>

            <div class="cap-row cap-row--secondary inactive">
              <div class="cap-row-left">
                <div class="cap-icon cap-icon--dim">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><path d="M9 22V12h6v10"/></svg>
                </div>
                <div>
                  <div class="cap-name">Hospice &amp; Home Health</div>
                  <div class="cap-sub">Care coordination, home visit programs</div>
                </div>
              </div>
              <div class="cap-badges">
                <div class="cap-badge">HIPAA</div>
              </div>
            </div>

            <div class="cap-row cap-row--secondary inactive">
              <div class="cap-row-left">
                <div class="cap-icon cap-icon--dim">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                </div>
                <div>
                  <div class="cap-name">FQHCs</div>
                  <div class="cap-sub">Federally Qualified Health Centers</div>
                </div>
              </div>
              <div class="cap-badges">
                <div class="cap-badge">HIPAA</div>
                <div class="cap-badge">UDS</div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function() {
  var rows = document.querySelectorAll('#capRows .cap-row');
  if (!rows.length) return;
  var active = 0;
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function activate(i) {
    rows.forEach(function(r, idx) {
      r.classList.toggle('active', idx === i);
      r.classList.toggle('inactive', idx !== i);
    });
    active = i;
  }

  function cycle() { activate((active + 1) % rows.length); }

  rows.forEach(function(r, i) {
    r.setAttribute('role', 'button');
    r.setAttribute('tabindex', '0');
    function select() {
      clearInterval(timer);
      activate(i);
      if (!prefersReduced) timer = setInterval(cycle, 4000);
    }
    r.addEventListener('click', select);
    r.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(); }
    });
  });

  var timer;
  if (!prefersReduced) timer = setInterval(cycle, 4000);
})();
</script>
