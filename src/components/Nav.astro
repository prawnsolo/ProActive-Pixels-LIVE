---

<header id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="ProActive Pixels — home">
      <img src="/trans-logo.png" alt="" class="nav-logo-mark" width="100" height="112" aria-hidden="true">
      <span class="nav-logo-text">Pro<span class="nav-logo-accent">Active</span> Pixels</span>
    </a>
    <nav class="nav-links">
      <a href="/about">About</a>
      <a href="/blog">Blog</a>
      <a href="/vendor-security">Vendor Security</a>
      <a href="/hipaa">HIPAA</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </nav>
    <div class="nav-ctas">
      <a href="mailto:solutions@proactivepixels.com" class="link">Contact</a>
      <a href="/capacity-review" class="btn-pill">Start Your Capacity Review</a>
    </div>
    <button class="nav-hamburger" id="navHamburger" aria-label="Open navigation" aria-expanded="false" aria-controls="mobileNavOverlay">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-nav-overlay" id="mobileNavOverlay" role="dialog" aria-modal="true" aria-label="Site navigation">
  <button class="mobile-nav-close" id="mobileNavClose" aria-label="Close navigation">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
  <a href="/about">About</a>
  <a href="/blog">Blog</a>
  <a href="/vendor-security">Vendor Security</a>
  <a href="/hipaa">HIPAA</a>
  <a href="/privacy">Privacy</a>
  <a href="/terms">Terms</a>
  <a href="mailto:solutions@proactivepixels.com">Contact</a>
  <a href="/capacity-review" class="btn-pill mobile-nav-cta" id="mobileNavCta">Start Your Capacity Review</a>
</div>

<style>
.mobile-nav-close {
  position: absolute;
  top: 20px;
  right: 20px;
  background: none;
  border: none;
  padding: 10px;
  cursor: pointer;
  color: var(--fg, oklch(18% 0.012 78));
  line-height: 0;
  border-radius: 6px;
  transition: background 0.15s;
}
.mobile-nav-close:hover {
  background: oklch(18% 0.012 78 / 0.06);
}
</style>

<script is:inline>
  document.getElementById('navHamburger').addEventListener('click', function() {
    var open = document.body.classList.toggle('nav-open');
    this.setAttribute('aria-expanded', open);
  });
  document.querySelectorAll('.mobile-nav-overlay a:not(#mobileNavCta)').forEach(function(a) {
    a.addEventListener('click', function() { document.body.classList.remove('nav-open'); });
  });
  document.getElementById('mobileNavCta').addEventListener('click', function() {
    document.body.classList.remove('nav-open');
  });
  document.getElementById('mobileNavClose').addEventListener('click', function() {
    document.body.classList.remove('nav-open');
    document.getElementById('navHamburger').setAttribute('aria-expanded', 'false');
  });
</script>

<script is:inline>
/* Nav — floating pill glass on scroll */
(function() {
  var nav = document.getElementById('nav');
  if (!nav) return;
  var ticking = false;
  function update() {
    nav.classList.toggle('scrolled', window.scrollY > 80);
    ticking = false;
  }
  window.addEventListener('scroll', function() {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });
  update();
})();
</script>
