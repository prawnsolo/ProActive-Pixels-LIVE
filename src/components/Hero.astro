<section id="hero">
  <div class="hero-grid"></div>
  <div class="hero-sphere">
    <canvas id="sphereCanvas" style="width:100%;height:100%;display:block;" width="800" height="800">Animated network visualization representing nonprofit connections</canvas>
  </div>
  <div class="container" style="position:relative;z-index:1;">
    <h1 class="hero-headline display">
      Every hour your team<br>
      spends on paperwork<br>
      is an hour <em>a donor paid for.</em>
    </h1>
    <div class="hero-body">
      <p class="hero-desc">
        Your staff didn't get into this work to fill out forms. We find where the hours go and build automations to recover them.
      </p>
      <p class="hero-pattern">
        We've analyzed intake workflows at free clinics, behavioral health orgs, and FQHCs — the bottlenecks repeat.
      </p>
      <div class="hero-ctas">
        <a href="#assessment" class="btn-pill btn-pill--lg" id="heroCtaBtn">
          Get Your Capacity Review
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
        </a>
        <a href="#how-it-works" class="btn-pill-outline">See how it works</a>
      </div>
      <p class="hero-byline">Jose Noriega &middot; Operations consultant &middot; Charlottesville&ndash;Richmond corridor</p>
    </div>
  </div>
  <div class="hero-stats">
    <div class="marquee-wrap marquee-secondary">
      <div class="marquee-track">
        <div class="stat-item"><span class="stat-value">HIPAA Compliant</span></div>
        <div class="stat-item"><span class="stat-value">Free Clinics</span></div>
