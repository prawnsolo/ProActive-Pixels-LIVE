<script is:inline>
/* ─── MAGNETIC CTA ─── */
(function() {
  if (!window.matchMedia('(hover:hover) and (pointer:fine)').matches) return;
  if (window.matchMedia('(prefers-reduced-motion:reduce)').matches) return;
  var btn = document.getElementById('heroCtaBtn');
  if (!btn) return;
  btn.style.transition = 'transform 0.45s cubic-bezier(0.16,1,0.3,1), opacity 0.2s';
  btn.addEventListener('mousemove', function(e) {
    var rect = btn.getBoundingClientRect();
    var dx = ((e.clientX - rect.left) / rect.width - 0.5) * 10;
    var dy = ((e.clientY - rect.top)  / rect.height - 0.5) * 6;
    btn.style.transform = 'translate(' + dx + 'px, ' + dy + 'px)';
  });
  btn.addEventListener('mouseleave', function() { btn.style.transform = ''; });
  btn.addEventListener('mousedown', function() { btn.style.transform = 'scale(0.97)'; });
  btn.addEventListener('mouseup', function() { btn.style.transform = ''; });
})();
</script>
