<section id="how-it-works">
  <div class="how-bg-lines"></div>
  <canvas id="howCanvas" aria-hidden="true"></canvas>
  <div class="container" style="position:relative;z-index:1;">
    <div class="how-header">
      <div class="section-label section-label--dark">Process</div>
      <h2 class="how-h2">
        Three steps.<br>
        <span class="how-h2-muted">We move at your pace.</span>
      </h2>
    </div>
    <div class="how-grid">
      <div class="how-steps" id="howSteps">

        <button class="how-step active" data-step="0">
          <div class="how-step-inner">
            <span class="how-step-num">I</span>
            <div class="how-step-content">
              <div class="how-step-title">Start your Capacity Review</div>
              <div class="how-step-desc">Answer three quick questions about your organization, then call Alex when you're ready. Twelve minutes. No prep beyond the questions you just answered.</div>
              <div class="how-progress"><div class="how-progress-bar"></div></div>
            </div>
          </div>
        </button>

        <button class="how-step inactive" data-step="1">
          <div class="how-step-inner">
            <span class="how-step-num">II</span>
            <div class="how-step-content">
              <div class="how-step-title">Talk through your day</div>
              <div class="how-step-desc">Alex asks about your workflows: intake, scheduling, follow-up, case notes, grant reporting. You describe what actually happens. Alex identifies where the hours go.</div>
              <div class="how-progress"><div class="how-progress-bar"></div></div>
            </div>
          </div>
        </button>

        <button class="how-step inactive" data-step="2">
          <div class="how-step-inner">
            <span class="how-step-num">III</span>
            <div class="how-step-content">
              <div class="how-step-title">Receive your Operations Assessment</div>
              <div class="how-step-desc">Within 24 hours, your Operations Assessment lands in your inbox. Your three biggest admin bottlenecks, ranked by recoverable hours. Specific findings. Clear next steps.</div>
              <div class="how-progress"><div class="how-progress-bar"></div></div>
            </div>
          </div>
        </button>

      </div>

      <!-- Report preview panel — static Operations Assessment sample -->
      <div>
        <div class="report-panel-frame">
          <div class="report-panel-header">
            <span class="report-panel-label">Sample Report</span>
            <span class="report-panel-badge">Operations Assessment</span>
          </div>
          <div class="rsp-wrap">
            <div class="rsp-org">
              <span class="rsp-org-name">Community Connections Free Clinic</span>
              <span class="rsp-org-meta mono">14 staff &middot; Capacity Review: 12 min &middot; Delivered in 24 hrs</span>
            </div>
            <div class="rsp-section">
              <div class="rsp-section-label mono">Top 3 bottlenecks &mdash; ranked by recoverable hours</div>
              <div class="rsp-row">
                <span class="rsp-num mono">01</span>
                <div class="rsp-detail">
                  <div class="rsp-title">New Patient Intake</div>
                  <div class="rsp-bar-wrap"><div class="rsp-bar" style="width:82%"></div></div>
                  <div class="rsp-hours mono">4.2 hrs / week recoverable</div>
                </div>
              </div>
              <div class="rsp-row">
                <span class="rsp-num mono">02</span>
                <div class="rsp-detail">
                  <div class="rsp-title">Appointment Reminders &amp; No-Show Follow-up</div>
                  <div class="rsp-bar-wrap"><div class="rsp-bar" style="width:55%"></div></div>
                  <div class="rsp-hours mono">2.8 hrs / week recoverable</div>
                </div>
              </div>
              <div class="rsp-row">
                <span class="rsp-num mono">03</span>
                <div class="rsp-detail">
                  <div class="rsp-title">Insurance Verification</div>
                  <div class="rsp-bar-wrap"><div class="rsp-bar" style="width:30%"></div></div>
                  <div class="rsp-hours mono">1.5 hrs / week recoverable</div>
                </div>
              </div>
            </div>
            <div class="rsp-total">
              <span class="rsp-total-label">Total recoverable</span>
              <span class="rsp-total-value">8.5 hrs / week</span>
            </div>
          </div>
          <a href="/capacity-review" class="report-panel-cta" aria-label="Get your Operations Assessment">
            <span class="report-panel-cta-label">Get your Operations Assessment</span>
            <span class="report-panel-cta-arrow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7v10"></path></svg></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
/* How It Works — scroll-triggered step activation */
(function() {
  var steps = document.querySelectorAll('#howSteps .how-step');
  if (!steps.length) return;
  var container = document.getElementById('howSteps');
  if (!container) return;
  var n = steps.length;

  function activate(i) {
    var idx = Math.max(0, Math.min(n - 1, i));
    steps.forEach(function(s, j) {
      s.classList.toggle('active', j === idx);
      s.classList.toggle('inactive', j !== idx);
    });
  }

  steps.forEach(function(s, i) {
    s.addEventListener('click', function() { activate(i); });
  });

  function onScroll() {
    var rect = container.getBoundingClientRect();
    var readLine = window.innerHeight * 0.45;
    var p = (readLine - rect.top) / rect.height;
    activate(p < 0 ? 0 : Math.min(Math.floor(p * n), n - 1));
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
})();
</script>

<style>
/* ── STATIC REPORT PREVIEW ────────────────────────────────────────────────── */
.rsp-wrap {
  padding: 20px;
  background: var(--bg-subtle, oklch(94% 0.008 252));
  border-bottom: 1px solid var(--border, oklch(89% 0.008 252));
}

.rsp-org {
  padding-bottom: 14px;
  margin-bottom: 14px;
  border-bottom: 1px solid var(--border, oklch(89% 0.008 252));
}

.rsp-org-name {
  display: block;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--fg, oklch(18% 0.012 78));
  margin-bottom: 2px;
}

.rsp-org-meta {
  display: block;
  font-size: 0.6875rem;
  color: var(--text-faint, oklch(62% 0.014 78));
  line-height: 1.4;
}

.rsp-section { margin-bottom: 14px; }

.rsp-section-label {
  display: block;
  font-size: 0.625rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-faint, oklch(62% 0.014 78));
  margin-bottom: 12px;
}

.rsp-row {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  margin-bottom: 12px;
}

.rsp-row:last-child { margin-bottom: 0; }

.rsp-num {
  font-size: 0.625rem;
  color: var(--text-faint, oklch(62% 0.014 78));
  padding-top: 1px;
  min-width: 16px;
  flex-shrink: 0;
}

.rsp-detail { flex: 1; min-width: 0; }

.rsp-title {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--fg, oklch(18% 0.012 78));
  margin-bottom: 4px;
  line-height: 1.3;
}

.rsp-bar-wrap {
  background: var(--border, oklch(89% 0.008 252));
  border-radius: 2px;
  height: 4px;
  margin-bottom: 3px;
  overflow: hidden;
}

.rsp-bar {
  height: 100%;
  background: var(--green, oklch(49% 0.12 244));
  border-radius: 2px;
}

.rsp-hours {
  font-size: 0.625rem;
  color: var(--text-faint, oklch(62% 0.014 78));
}

.rsp-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12px;
  border-top: 1px solid var(--border, oklch(89% 0.008 252));
}

.rsp-total-label {
  font-size: 0.6875rem;
  color: var(--text-muted, oklch(46% 0.018 78));
}

.rsp-total-value {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--green, oklch(49% 0.12 244));
}

/* Dark mode */
@media (prefers-color-scheme: dark) {
  .rsp-wrap { background: oklch(22% 0.01 252 / 0.6); }
}
</style>
