<!-- ─── ALL CANVAS ANIMATIONS ─── -->
<script is:inline>
(function () {
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  /* ── SPHERE (hero background) ── */
  (function () {
    var canvas = document.getElementById('sphereCanvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;
    var chars = '░▒▓█▀▄▌▐│─┤├┴┬╭╮╰╯';
    var time = 0;
    function resize() {
      var dpr = window.devicePixelRatio || 1;
      var rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);
    }
    resize();
    window.addEventListener('resize', resize);
    function render() {
      var rect = canvas.getBoundingClientRect();
      ctx.clearRect(0, 0, rect.width, rect.height);
      var cx = rect.width / 2, cy = rect.height / 2;
      var radius = Math.min(rect.width, rect.height) * 0.525;
      ctx.font = '12px monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      var points = [];
      for (var phi = 0; phi < Math.PI * 2; phi += 0.15) {
        for (var theta = 0; theta < Math.PI; theta += 0.15) {
          var x = Math.sin(theta) * Math.cos(phi + time * 0.5);
          var y = Math.sin(theta) * Math.sin(phi + time * 0.5);
          var z = Math.cos(theta);
          var ry = time * 0.3;
          var nx = x * Math.cos(ry) - z * Math.sin(ry);
          var nz = x * Math.sin(ry) + z * Math.cos(ry);
          var rx = time * 0.2;
          var ny = y * Math.cos(rx) - nz * Math.sin(rx);
          var fz = y * Math.sin(rx) + nz * Math.cos(rx);
          var depth = (fz + 1) / 2;
          var ci = Math.floor(depth * (chars.length - 1));
          points.push({ x: cx + nx * radius, y: cy + ny * radius, z: fz, ch: chars[ci] });
        }
      }
      points.sort(function (a, b) { return a.z - b.z; });
      points.forEach(function (p) {
        ctx.fillStyle = 'rgba(0,0,0,' + (0.2 + (p.z + 1) * 0.4) + ')';
        ctx.fillText(p.ch, p.x, p.y);
      });
      time += 0.02;
      requestAnimationFrame(render);
    }
    render();
  })();

  /* ── TETRAHEDRON (CTA section) ── */
  (function () {
    var canvas = document.getElementById('tetraCanvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;
    var chars = '░▒▓█▀▄▌▐│─┤├┴┬╭╮╰╯';
    var time = 0;
    var vertices = [
      { x: 0,      y: 1,      z: 0    },
      { x: -0.943, y: -0.333, z: -0.5 },
      { x: 0.943,  y: -0.333, z: -0.5 },
      { x: 0,      y: -0.333, z: 1    }
    ];
    var edges = [[0,1],[0,2],[0,3],[1,2],[2,3],[3,1]];
    var faces = [[0,1,2],[0,2,3],[0,3,1],[1,3,2]];
    function resize() {
      var dpr = window.devicePixelRatio || 1;
      var rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);
    }
    resize();
    window.addEventListener('resize', resize);
    function ry(p, a) { return { x: p.x*Math.cos(a)-p.z*Math.sin(a), y: p.y, z: p.x*Math.sin(a)+p.z*Math.cos(a) }; }
    function rx(p, a) { return { x: p.x, y: p.y*Math.cos(a)-p.z*Math.sin(a), z: p.y*Math.sin(a)+p.z*Math.cos(a) }; }
    function rz(p, a) { return { x: p.x*Math.cos(a)-p.y*Math.sin(a), y: p.x*Math.sin(a)+p.y*Math.cos(a), z: p.z }; }
    function render() {
      var rect = canvas.getBoundingClientRect();
      ctx.clearRect(0, 0, rect.width, rect.height);
      var cx = rect.width / 2, cy = rect.height / 2;
      var scale = Math.min(rect.width, rect.height) * 0.7;
      ctx.font = '18px monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      var points = [];
      edges.forEach(function (e) {
        var v1 = vertices[e[0]], v2 = vertices[e[1]];
        for (var t = 0; t <= 1; t += 0.05) {
          var p = { x: v1.x+(v2.x-v1.x)*t, y: v1.y+(v2.y-v1.y)*t, z: v1.z+(v2.z-v1.z)*t };
          p = ry(p,time*0.4); p = rx(p,time*0.3); p = rz(p,time*0.2);
          var ci = Math.min(Math.floor(((p.z+1.5)/3)*(chars.length-1)), chars.length-1);
          points.push({ x: cx+p.x*scale, y: cy-p.y*scale, z: p.z, ch: chars[ci] });
        }
      });
      faces.forEach(function (f) {
        var v1=vertices[f[0]], v2=vertices[f[1]], v3=vertices[f[2]];
        for (var u=0; u<=1; u+=0.12) {
          for (var v=0; v<=1-u; v+=0.12) {
            var w=1-u-v;
            var p={x:v1.x*u+v2.x*v+v3.x*w, y:v1.y*u+v2.y*v+v3.y*w, z:v1.z*u+v2.z*v+v3.z*w};
            p = ry(p,time*0.4); p = rx(p,time*0.3); p = rz(p,time*0.2);
            var ci=Math.min(Math.floor(((p.z+1.5)/3)*(chars.length-1)),chars.length-1);
            points.push({x:cx+p.x*scale, y:cy-p.y*scale, z:p.z, ch:chars[ci]});
          }
        }
      });
      points.sort(function (a, b) { return a.z - b.z; });
      points.forEach(function (p) {
        ctx.fillStyle = 'rgba(0,0,0,' + Math.min(0.15+(p.z+1.5)*0.25, 0.9) + ')';
        ctx.fillText(p.ch, p.x, p.y);
      });
      time += 0.015;
      requestAnimationFrame(render);
    }
    render();
  })();

  /* ── HOW IT WORKS ambient particle field ── */
  (function () {
    var canvas = document.getElementById('howCanvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;
    var chars = '·∘○◯◌';
    var pts = [];
    var W = 0, H = 0;
    function resize() {
      var dpr = window.devicePixelRatio || 1;
      var rect = canvas.getBoundingClientRect();
      W = rect.width; H = rect.height;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.scale(dpr, dpr);
      init();
    }
    function init() {
      pts = [];
      var count = Math.max(20, Math.floor((W * H) / 14000));
      for (var i = 0; i < count; i++) {
        pts.push({
          x: Math.random() * W, y: Math.random() * H,
          vx: (Math.random() - 0.5) * 0.18,
          vy: (Math.random() - 0.5) * 0.14,
          phase: Math.random() * Math.PI * 2,
          spd: 0.003 + Math.random() * 0.004
        });
      }
    }
    resize();
    window.addEventListener('resize', resize);
    function render() {
      ctx.clearRect(0, 0, W, H);
      ctx.font = '11px monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      pts.forEach(function(p) {
        p.phase += p.spd;
        p.x += p.vx; p.y += p.vy;
        if (p.x < -20) p.x = W + 20;
        if (p.x > W + 20) p.x = -20;
        if (p.y < -20) p.y = H + 20;
        if (p.y > H + 20) p.y = -20;
        var a = 0.08 + Math.abs(Math.sin(p.phase)) * 0.1;
        var ci = Math.floor(((Math.sin(p.phase) + 1) / 2) * (chars.length - 1));
        ctx.fillStyle = 'rgba(240,235,224,' + a + ')';
        ctx.fillText(chars[ci], p.x, p.y);
      });
      requestAnimationFrame(render);
    }
    render();
  })();

  /* ── WAVE (footer accent) ── */
  (function () {
    var canvas = document.getElementById('waveCanvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;
    var chars = '·∘○◯◌●◉';
    var time = 0;
    function resize() {
      var dpr = window.devicePixelRatio || 1;
      var rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);
    }
    resize();
    window.addEventListener('resize', resize);
    function render() {
      var rect = canvas.getBoundingClientRect();
      ctx.clearRect(0, 0, rect.width, rect.height);
      ctx.font = '14px monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      var cols = Math.floor(rect.width / 20);
      var rows = Math.floor(rect.height / 20);
      for (var y = 0; y < rows; y++) {
        for (var x = 0; x < cols; x++) {
          var px = (x+0.5)*(rect.width/cols);
          var py = (y+0.5)*(rect.height/rows);
          var w1 = Math.sin(x*0.2+time*2)*Math.cos(y*0.15+time);
          var w2 = Math.sin((x+y)*0.1+time*1.5);
          var w3 = Math.cos(x*0.1-y*0.1+time*0.8);
          var norm = ((w1+w2+w3)/3+1)/2;
          var ci = Math.floor(norm*(chars.length-1));
          ctx.fillStyle = 'rgba(255,255,255,' + (0.06+norm*0.12) + ')';
          ctx.fillText(chars[ci], px, py);
        }
      }
      time += 0.03;
      requestAnimationFrame(render);
    }
    render();
  })();

})();
</script>

<!-- ─── INTERSECTION OBSERVER — SCROLL REVEALS ─── -->
<script is:inline>
(function() {
  if (!('IntersectionObserver' in window)) return;
  if (window.matchMedia('(prefers-reduced-motion:reduce)').matches) return;

  var all = [];

  function add(sel, delayStep) {
    document.querySelectorAll(sel).forEach(function(el, i) {
      el.classList.add('reveal');
      if (delayStep) el.style.transitionDelay = (i * delayStep) + 'ms';
      all.push(el);
    });
  }

  /* Staggered groups */
  add('#featuresList .feature-row', 80);
  add('.infra-stats > *', 100);
  add('.metrics-grid .metric-cell', 60);
  add('.security-features .sec-feature', 80);
  add('.assess-value-list .assess-value-item', 60);

  /* Section headers and singles */
  add('#infrastructure .section-label');
  add('#infrastructure .section-h2');
  add('#metrics .section-label');
  add('#metrics .section-h2');
  add('#security .section-label');
  add('#security .section-h2');
  add('#results-expectation .section-label');
  add('#results-expectation .section-h2');
  add('#assessment .section-label');
  add('#assessment .section-h2');
  add('#cta .cta-h2');
  add('#cta .cta-desc');

  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (!e.isIntersecting) return;
      var el = e.target;
      el.classList.add('revealed');
      io.unobserve(el);
      el.addEventListener('transitionend', function onDone(evt) {
        if (evt.propertyName !== 'opacity') return;
        el.removeEventListener('transitionend', onDone);
        el.classList.remove('reveal', 'revealed');
        el.style.transitionDelay = '';
      });
    });
  }, { rootMargin: '0px 0px -60px 0px', threshold: 0.12 });

  all.forEach(function(el) { io.observe(el); });
})();
</script>
