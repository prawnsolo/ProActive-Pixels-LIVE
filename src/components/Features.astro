---

<section id="features">
  <div class="container">
    <div class="features-header">
      <div class="section-label">The Real Cost</div>
      <h2 class="section-h2 display">
        Every grant you wrote<br>
        <span style="color:var(--green-bright)">funded this too.</span>
      </h2>
    </div>
    <div id="featuresList">

      <!-- Feature 01: Intake -->
      <div class="feature-row">
        <div class="feature-num">01</div>
        <div class="feature-content">
          <div>
            <h3 class="feature-title">Intake that takes longer than the visit</h3>
            <p class="feature-desc">New patient onboarding averages 35 minutes of staff time before anyone sees a clinician. Insurance verification, consent forms, demographic entry across systems that don't talk to each other. Your program coordinator didn't get into this work to enter data.</p>
          </div>
          <div class="feature-visual">
            <svg viewBox="0 0 192 160" aria-hidden="true">
              <rect x="32" y="16" width="128" height="128" rx="4" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".3"/>
              <rect x="48" y="36" width="96" height="8" rx="2" fill="currentColor" opacity=".15">
                <animate attributeName="opacity" values=".15;.7;.15" dur="2.8s" begin="0s" repeatCount="indefinite"/>
              </rect>
              <rect x="48" y="54" width="96" height="8" rx="2" fill="currentColor" opacity=".15">
                <animate attributeName="opacity" values=".15;.7;.15" dur="2.8s" begin=".2s" repeatCount="indefinite"/>
              </rect>
              <rect x="48" y="72" width="60" height="8" rx="2" fill="currentColor" opacity=".15">
                <animate attributeName="opacity" values=".15;.7;.15" dur="2.8s" begin=".4s" repeatCount="indefinite"/>
              </rect>
              <rect x="48" y="96" width="96" height="8" rx="2" fill="currentColor" opacity=".15">
                <animate attributeName="opacity" values=".15;.7;.15" dur="2.8s" begin=".6s" repeatCount="indefinite"/>
              </rect>
              <rect x="48" y="114" width="72" height="8" rx="2" fill="currentColor" opacity=".15">
                <animate attributeName="opacity" values=".15;.7;.15" dur="2.8s" begin=".8s" repeatCount="indefinite"/>
              </rect>
            </svg>
          </div>
        </div>
      </div>

      <!-- Feature 02: Scheduling -->
      <div class="feature-row">
        <div class="feature-num">02</div>
        <div class="feature-content">
          <div>
            <h3 class="feature-title">Scheduling that still needs a phone call</h3>
            <p class="feature-desc">Every rescheduled appointment that requires a human is a reminder not sent, a slot that sat empty, a patient who stopped trying. The front desk absorbs all of it. You absorb the gaps in your metrics.</p>
          </div>
          <div class="feature-visual">
            <svg viewBox="0 0 192 160" aria-hidden="true">
              <rect x="24" y="24" width="144" height="112" rx="4" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".3"/>
              <line x1="24" y1="48" x2="168" y2="48" stroke="currentColor" stroke-width="1" opacity=".2"/>
              <g opacity=".5">
                <rect x="36" y="60" width="28" height="20" rx="2" fill="currentColor" opacity=".2"/>
                <rect x="72" y="60" width="28" height="20" rx="2" fill="currentColor" opacity=".6">
                  <animate attributeName="opacity" values=".6;1;.6" dur="2s" begin="0s" repeatCount="indefinite"/>
                </rect>
                <rect x="108" y="60" width="28" height="20" rx="2" fill="currentColor" opacity=".2"/>
                <rect x="36" y="88" width="28" height="20" rx="2" fill="currentColor" opacity=".2"/>
                <rect x="72" y="88" width="28" height="20" rx="2" fill="currentColor" opacity=".2"/>
                <rect x="108" y="88" width="28" height="20" rx="2" fill="currentColor" opacity=".6">
                  <animate attributeName="opacity" values=".6;1;.6" dur="2s" begin=".6s" repeatCount="indefinite"/>
                </rect>
                <rect x="36" y="116" width="28" height="12" rx="2" fill="currentColor" opacity=".2"/>
                <rect x="72" y="116" width="28" height="12" rx="2" fill="currentColor" opacity=".2"/>
                <rect x="108" y="116" width="28" height="12" rx="2" fill="currentColor" opacity=".2"/>
              </g>
            </svg>
          </div>
        </div>
      </div>

      <!-- Feature 03: Follow-up -->
      <div class="feature-row">
        <div class="feature-num">03</div>
        <div class="feature-content">
          <div>
            <h3 class="feature-title">Follow-up that depends on someone remembering</h3>
            <p class="feature-desc">Most missed follow-ups aren't a staff problem. They're a systems problem. No automated trigger. No workflow. Just a person scanning a list and hoping. With PHI involved, hope is not a protocol.</p>
          </div>
          <div class="feature-visual">
            <svg viewBox="0 0 192 160" aria-hidden="true">
              <circle cx="40" cy="80" r="16" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".5"/>
              <circle cx="96" cy="80" r="16" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".5"/>
              <circle cx="152" cy="80" r="16" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".2"/>
              <line x1="56" y1="80" x2="80" y2="80" stroke="currentColor" stroke-width="1.5" opacity=".5" stroke-dasharray="4 3">
                <animate attributeName="stroke-dashoffset" values="0;-14" dur="1s" repeatCount="indefinite"/>
              </line>
              <line x1="112" y1="80" x2="136" y2="80" stroke="currentColor" stroke-width="1.5" opacity=".2" stroke-dasharray="4 3"/>
              <circle cx="152" cy="80" r="4" fill="currentColor" opacity=".2"/>
              <circle cx="40" cy="80" r="6" fill="currentColor" opacity=".6">
                <animate attributeName="opacity" values=".6;1;.6" dur="2s" repeatCount="indefinite"/>
              </circle>
              <circle cx="96" cy="80" r="6" fill="currentColor" opacity=".6">
                <animate attributeName="opacity" values=".6;1;.6" dur="2s" begin=".5s" repeatCount="indefinite"/>
              </circle>
              <text x="148" y="52" font-family="monospace" font-size="22" fill="currentColor" opacity=".2" text-anchor="middle">?</text>
            </svg>
          </div>
        </div>
      </div>

      <!-- Feature 04: Reporting -->
      <div class="feature-row">
        <div class="feature-num">04</div>
        <div class="feature-content">
          <div>
            <h3 class="feature-title">Reports that start the week they're due</h3>
            <p class="feature-desc">The data exists. It's spread across your EHR, intake forms, and a spreadsheet someone built in 2018. Pulling a grant deliverable takes four days and two staff members. That's not a data problem. That's an architecture problem.</p>
          </div>
          <div class="feature-visual">
            <svg viewBox="0 0 192 160" aria-hidden="true">
              <rect x="20" y="32" width="60" height="72" rx="3" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".35"/>
              <rect x="28" y="44" width="44" height="6" rx="1" fill="currentColor" opacity=".2"/>
              <rect x="28" y="56" width="36" height="6" rx="1" fill="currentColor" opacity=".2"/>
              <rect x="28" y="68" width="44" height="6" rx="1" fill="currentColor" opacity=".2"/>
              <rect x="28" y="80" width="28" height="6" rx="1" fill="currentColor" opacity=".2"/>
              <rect x="68" y="20" width="60" height="72" rx="3" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".35"/>
              <rect x="76" y="32" width="44" height="6" rx="1" fill="currentColor" opacity=".2"/>
              <rect x="76" y="44" width="36" height="6" rx="1" fill="currentColor" opacity=".2"/>
              <rect x="76" y="56" width="44" height="6" rx="1" fill="currentColor" opacity=".2"/>
              <rect x="112" y="44" width="60" height="72" rx="3" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".5">
                <animate attributeName="opacity" values=".5;.9;.5" dur="2.5s" repeatCount="indefinite"/>
              </rect>
              <rect x="120" y="56" width="44" height="6" rx="1" fill="currentColor" opacity=".4">
                <animate attributeName="opacity" values=".4;.8;.4" dur="2.5s" repeatCount="indefinite"/>
              </rect>
              <rect x="120" y="68" width="36" height="6" rx="1" fill="currentColor" opacity=".3"/>
              <rect x="120" y="80" width="44" height="6" rx="1" fill="currentColor" opacity=".3"/>
              <rect x="120" y="92" width="28" height="6" rx="1" fill="currentColor" opacity=".2"/>
            </svg>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
/* Pause SMIL animations on feature SVGs when scrolled out of view — reduces mobile background work */
(function() {
  if (!('IntersectionObserver' in window)) return;
  document.querySelectorAll('#featuresList .feature-visual svg').forEach(function(svg) {
    svg.pauseAnimations();
    var obs = new IntersectionObserver(function(entries) {
      entries[0].isIntersecting ? svg.unpauseAnimations() : svg.pauseAnimations();
    }, { rootMargin: '100px' });
    obs.observe(svg);
  });
})();
</script>
