---
const objections = [
  {
    quote: '"Is this built for organizations like ours?"',
    answer:
      "We only work with HIPAA-regulated nonprofits. Free clinics, behavioral health orgs, substance use programs, FQHCs. By the time you call Alex, we already know the workflows most likely draining your team. The Capacity Review confirms the specifics.",
  },
  {
    quote: '"We\'ve been burned by vendors who promised results."',
    answer:
      "Most implementations fail because someone sold a tool before diagnosing the problem. We diagnose first. The Operations Assessment shows exactly where your hours are going before any recommendation gets made. No prescription before the exam.",
  },
  {
    quote: '"This is probably just a sales pitch."',
    answer:
      "The Operations Assessment is yours whether you work with us or not. No follow-up call unless you request one. No invoice. Read it, share it with your board, or file it away. We're building nonprofit case studies. That's the honest reason it costs you nothing.",
  },
  {
    quote: '"Our board would have questions about data security."',
    answer:
      "So would ours, if we were in your seat. Every tool we recommend is HIPAA-compliant. We sign a Business Associate Agreement at the start of every engagement. Nothing in the Capacity Review touches patient data. Your name, your organization, and 12 minutes of your time. That's the ask.",
  },
];
---

<section class="objections">
  <div class="objections__inner">
    <h2 class="objections__heading">We've heard these.</h2>
    {
      objections.map((item, i) => (
        <div class={`objection fade-in fade-in-delay-${i + 1}`}>
          <p class="objection__quote">{item.quote}</p>
          <p class="objection__answer">{item.answer}</p>
        </div>
      ))
    }

    <div class="objections__cta fade-in fade-in-delay-3">
      <a href="#assessment" class="btn btn--primary">
        Start My Capacity Review
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M3.75 9h10.5M9.75 4.5L14.25 9l-4.5 4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .objections {
    padding: 80px 24px 100px;
    background: var(--color-bg);
  }

  .objections__inner {
    max-width: var(--max-content);
    margin: 0 auto;
  }

  .objections__heading {
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.01em;
    margin-bottom: 40px;
    text-wrap: balance;
  }

  .objection {
    padding-top: 40px;
    margin-bottom: 0;
  }

  .objection + .objection {
    border-top: 1px solid var(--color-border);
  }

  .objections__heading + .objection {
    padding-top: 0;
  }

  .objection:last-of-type {
    margin-bottom: 0;
  }

  .objection__quote {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 10px;
    line-height: 1.5;
  }

  .objection__answer {
    font-size: 16px;
    color: var(--color-body);
    line-height: 1.75;
    text-wrap: pretty;
  }

  .objections__cta {
    margin-top: 60px;
    display: flex;
    justify-content: center;
  }

  @media (max-width: 600px) {
    .objections__cta .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
