<section id="cta">
  <div class="container">
    <div class="cta-box" id="ctaBox">
      <div class="cta-spotlight" id="ctaSpotlight"></div>
      <div class="cta-corner-tl"></div>
      <div class="cta-corner-br"></div>
      <div class="cta-inner">
        <div>
          <h2 class="cta-h2 display">The hours are there.<br>Here's how we find them.</h2>
          <p class="cta-desc">You don't need to know what's wrong before you call. The Capacity Review is 12 minutes. A few questions about how your organization runs. Alex handles the conversation. Your Operations Assessment arrives the next day.</p>
          <ul class="cta-bullets">
            <li>No technical knowledge needed</li>
            <li>No commitment beyond the conversation</li>
            <li>Your Operations Assessment is yours to keep</li>
            <li>We'll have it in your inbox within 24 hours</li>
          </ul>
          <div class="cta-actions">
            <a href="#assessment" class="btn-pill btn-pill--lg">
              Get Your Capacity Review
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
            </a>
          </div>
          <p class="cta-note">Questions first? solutions@proactivepixels.com</p>
        </div>
        <div class="tetra-wrap">
          <canvas id="tetraCanvas" style="width:100%;height:100%;display:block;" width="420" height="420">Animated geometric visualization</canvas>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
/* CTA spotlight follows mouse */
(function() {
  var box = document.getElementById('ctaBox');
  var spotlight = document.getElementById('ctaSpotlight');
  if (!box || !spotlight) return;
  if (!window.matchMedia('(hover:hover) and (pointer:fine)').matches) return;
  box.addEventListener('mousemove', function(e) {
    var rect = box.getBoundingClientRect();
    var x = e.clientX - rect.left;
    var y = e.clientY - rect.top;
    spotlight.style.background = 'radial-gradient(600px circle at ' + x + 'px ' + y + 'px, oklch(18% 0.012 78 / .12), transparent 40%)';
  });
  box.addEventListener('mouseleave', function() {
    spotlight.style.background = 'radial-gradient(600px circle at 50% 50%, oklch(18% 0.012 78 / .2), transparent 40%)';
  });
})();
</script>
