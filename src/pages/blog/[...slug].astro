---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props:  { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const subNicheLabels: Record<string, string> = {
  'free-clinics':       'Free Clinics',
  'community-health':   'Community Health Centers',
  'behavioral-health':  'Behavioral Health',
  'addiction-treatment':'Addiction Treatment',
  'mental-health':      'Mental Health',
  'hospice':            'Hospice & Home Health',
  'fqhc':               'FQHCs',
  'general':            'General',
};

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric'
});
---

<BaseLayout
  title={`${post.data.title} | ProActive Pixels`}
  description={post.data.description}
  canonical={`https://proactivepixels.com/blog/${post.slug}`}
>
  <Nav />

  <!-- ══ POST HEADER ════════════════════════════════════════════════════════ -->
  <header class="bp-header">
    <div class="container">
      <div class="bp-breadcrumb mono">
        <a href="/blog">Blog</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span>{subNicheLabels[post.data.subNiche] ?? post.data.subNiche}</span>
      </div>
      {post.data.isPillar && (
        <span class="bp-pillar-badge mono">Sub-niche guide</span>
      )}
      <h1 class="bp-title display">{post.data.title}</h1>
      <p class="bp-description">{post.data.description}</p>
      <div class="bp-byline">
        <span class="bp-author mono">{post.data.author}</span>
        <span class="bp-dot" aria-hidden="true">&bull;</span>
        <time class="bp-date mono" datetime={post.data.pubDate.toISOString()}>
          {formattedDate}
        </time>
      </div>
    </div>
  </header>

  <!-- ══ ARTICLE BODY ═══════════════════════════════════════════════════════ -->
  <article class="bp-article">
    <div class="container bp-article-grid">
      <div class="bp-content prose">
        <Content />
      </div>

      <!-- Sticky sidebar CTA -->
      <aside class="bp-sidebar">
        <div class="bp-sidebar-card">
          <p class="bp-sidebar-label mono">Ready to find your hours?</p>
          <h2 class="bp-sidebar-h2">Start a Capacity Review</h2>
          <p class="bp-sidebar-body">
            12 minutes. Your three biggest admin bottlenecks, ranked by recoverable hours. Written Operations Assessment in 24 hours.
          </p>
          <a href="/capacity-review" class="btn-pill bp-sidebar-cta">
            Start Your Capacity Review
          </a>
          <p class="bp-sidebar-note mono">No pitch on the call.</p>
        </div>
      </aside>
    </div>
  </article>

  <!-- ══ BOTTOM CTA ═════════════════════════════════════════════════════════ -->
  <section class="bp-cta">
    <div class="container bp-cta-inner">
      <h2 class="bp-cta-h2 display">
        12 minutes.<br>
        <em>Operations Assessment in 24 hours.</em>
      </h2>
      <p class="bp-cta-sub">
        No pitch on the call. No commitment after. Just your three biggest bottlenecks, ranked by recoverable hours.
      </p>
      <a href="/capacity-review" class="btn-pill btn-pill--lg">
        Start Your Capacity Review
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
/* ── POST HEADER ──────────────────────────────────────────────────────────── */
.bp-header {
  padding: 100px 0 60px;
  border-bottom: 1px solid var(--border);
}

.bp-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: var(--text-xs, 0.6875rem);
  color: var(--text-faint);
  margin-bottom: 16px;
}

.bp-breadcrumb a {
  color: var(--green);
  text-decoration: none;
}

.bp-breadcrumb a:hover { text-decoration: underline; }

.bp-pillar-badge {
  display: inline-block;
  font-size: var(--text-xs, 0.6875rem);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--green);
  background: var(--green-pale, oklch(95% 0.015 252));
  border: 1px solid oklch(49% 0.12 244 / 0.2);
  border-radius: var(--r-pill);
  padding: 3px 10px;
  margin-bottom: 16px;
}

.bp-title {
  font-size: clamp(2rem, 4.5vw, 3.5rem);
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--fg);
  margin-bottom: 20px;
  max-width: 760px;
}

.bp-description {
  font-size: 1.125rem;
  color: var(--text-muted);
  line-height: 1.65;
  max-width: 640px;
  margin-bottom: 24px;
}

.bp-byline {
  display: flex;
  align-items: center;
  gap: 10px;
}

.bp-author, .bp-date {
  font-size: var(--text-sm, 0.8125rem);
  color: var(--text-faint);
}

.bp-dot { color: var(--border-mid); font-size: 0.5rem; }

/* ── ARTICLE BODY ─────────────────────────────────────────────────────────── */
.bp-article {
  padding: 64px 0 80px;
}

.bp-article-grid {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 64px;
  align-items: start;
}

@media (max-width: 900px) {
  .bp-article-grid {
    grid-template-columns: 1fr;
  }
  .bp-sidebar { order: -1; }
}

/* ── PROSE STYLES ─────────────────────────────────────────────────────────── */
.bp-content.prose {
  max-width: 660px;
  font-size: 1.0625rem;
  line-height: 1.75;
  color: var(--text-muted);
}

.bp-content.prose :global(h2) {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 400;
  color: var(--fg);
  line-height: 1.2;
  letter-spacing: -0.02em;
  margin: 48px 0 16px;
}

.bp-content.prose :global(h3) {
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--fg);
  margin: 36px 0 12px;
  line-height: 1.3;
}

.bp-content.prose :global(p) {
  margin-bottom: 20px;
}

.bp-content.prose :global(p):last-child { margin-bottom: 0; }

.bp-content.prose :global(ul),
.bp-content.prose :global(ol) {
  padding-left: 24px;
  margin-bottom: 20px;
}

.bp-content.prose :global(li) {
  margin-bottom: 8px;
  line-height: 1.7;
}

.bp-content.prose :global(strong) {
  color: var(--fg);
  font-weight: 600;
}

.bp-content.prose :global(a) {
  color: var(--green);
  text-decoration: underline;
  text-underline-offset: 3px;
}

.bp-content.prose :global(blockquote) {
  border-left: 3px solid var(--green);
  margin: 28px 0;
  padding: 4px 0 4px 20px;
  font-style: italic;
  color: var(--fg);
  font-family: var(--font-serif);
  font-size: 1.125rem;
}

.bp-content.prose :global(hr) {
  border: none;
  border-top: 1px solid var(--border);
  margin: 40px 0;
}

/* ── SIDEBAR ──────────────────────────────────────────────────────────────── */
.bp-sidebar {
  position: sticky;
  top: 100px;
}

.bp-sidebar-card {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 24px;
  background: var(--bg-subtle);
}

.bp-sidebar-label {
  font-size: var(--text-xs, 0.6875rem);
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--text-faint);
  margin-bottom: 8px;
}

.bp-sidebar-h2 {
  font-size: 1.0625rem;
  font-weight: 600;
  color: var(--fg);
  margin-bottom: 10px;
  line-height: 1.3;
}

.bp-sidebar-body {
  font-size: 0.875rem;
  color: var(--text-muted);
  line-height: 1.65;
  margin-bottom: 20px;
}

.bp-sidebar-cta {
  display: block;
  text-align: center;
  margin-bottom: 12px;
  font-size: var(--text-sm);
}

.bp-sidebar-note {
  font-size: var(--text-xs, 0.6875rem);
  color: var(--text-faint);
  text-align: center;
}

/* ── BOTTOM CTA ───────────────────────────────────────────────────────────── */
.bp-cta {
  padding: var(--s-section) 0;
  background: var(--brand-navy, #171E62);
  border-top: 1px solid oklch(97% 0.007 78 / 0.08);
}

.bp-cta-inner { max-width: 520px; }

.bp-cta-h2 {
  font-size: clamp(1.75rem, 3vw, 2.75rem);
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--fg-dark, oklch(97% 0.007 78));
  margin-bottom: 14px;
}

.bp-cta-h2 em {
  font-style: italic;
  color: var(--green-bright, oklch(67% 0.10 228));
}

.bp-cta-sub {
  font-size: 1rem;
  color: var(--fg-dark-muted, oklch(97% 0.007 78 / 0.6));
  line-height: 1.65;
  margin-bottom: 32px;
}
</style>
