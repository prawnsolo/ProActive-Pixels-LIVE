---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="ProActive Pixels | HIPAA Nonprofit Admin Automation"
  description="Your staff hours belong to your mission, not to paperwork. We find where the hours go and help you get them back. A Capacity Review takes 12 minutes."
  canonical="https://proactivepixels.com"
>
  <Nav />

  <!-- ══ HERO ══════════════════════════════════════════════════════════════ -->
  <section id="home-hero" class="hm-hero">
    <div class="hm-hero-sphere">
      <canvas id="sphereCanvas" width="900" height="900" aria-hidden="true"></canvas>
    </div>
    <div class="container hm-hero-inner">
      <h1 class="hm-h1 display">
        Your staff hours<br>
        belong to your mission.<br>
        <em>Not to paperwork.</em>
      </h1>
      <p class="hm-sub">We find where the hours go and redirect them back to program delivery.</p>
      <div class="hm-ctas">
        <a href="/capacity-review" class="btn-pill btn-pill--lg">
          Start Your Capacity Review
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/blog" class="btn-pill-outline">See how it works</a>
      </div>
    </div>
  </section>

  <!-- ══ WHO IT'S FOR ═══════════════════════════════════════════════════════ -->
  <section class="hm-qualify">
    <div class="container">
      <p class="section-label">Is this for you?</p>
      <h2 class="hm-section-h2">Right fit. Wrong fit. Be honest.</h2>
      <p class="hm-section-sub">The Capacity Review is built for one kind of organization. If yours matches, it will find something. If it doesn't, we'll tell you.</p>
      <div class="hm-qualify-grid">
        <div class="hm-qualify-card hm-qualify-yes">
          <div class="hm-qualify-label mono">This is for you if&hellip;</div>
          <ul class="hm-qualify-list">
            <li>Your organization handles protected health information (PHI)</li>
            <li>You have 5&ndash;50 paid staff</li>
            <li>Staff spend hours each week on intake paperwork, scheduling, or documentation</li>
            <li>You're a free clinic, community health center, behavioral health org, substance abuse treatment program, mental health nonprofit, hospice, or FQHC</li>
            <li>An Executive Director, Operations Director, or Program Manager is reading this</li>
          </ul>
        </div>
        <div class="hm-qualify-card hm-qualify-no">
          <div class="hm-qualify-label mono">This is not for you if&hellip;</div>
          <ul class="hm-qualify-list">
            <li>Your organization is for-profit</li>
            <li>You don't handle PHI or have no HIPAA obligations</li>
            <li>You're looking for general software consulting, not admin workflow recovery</li>
            <li>You want a technology vendor, not a diagnostic</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ THREE PATHS ════════════════════════════════════════════════════════ -->
  <section class="hm-paths">
    <div class="container">
      <p class="section-label">Where do you want to start?</p>
      <h2 class="hm-section-h2">Three ways in.</h2>
      <div class="hm-paths-grid">

        <a href="/capacity-review" class="hm-path-card hm-path-primary">
          <div class="hm-path-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="hm-path-tag mono">Ready now</div>
          <h3 class="hm-path-title">Start Your Capacity Review</h3>
          <p class="hm-path-desc">Answer three questions, call Alex, receive your Operations Assessment within 24 hours. Your three biggest bottlenecks, ranked by recoverable staff hours.</p>
          <span class="hm-path-link">
            Begin the review
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>

        <a href="/blog" class="hm-path-card">
          <div class="hm-path-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <div class="hm-path-tag mono">Want to learn first</div>
          <h3 class="hm-path-title">Read the Blog</h3>
          <p class="hm-path-desc">Articles on admin bottlenecks by sub-niche&mdash;free clinics, behavioral health, FQHCs, and more. Specific problems. No generic advice.</p>
          <span class="hm-path-link">
            Browse the blog
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>

        <a href="/vendor-security" class="hm-path-card">
          <div class="hm-path-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="hm-path-tag mono">Evaluating a vendor</div>
          <h3 class="hm-path-title">Build a Vendor Security Questionnaire</h3>
          <p class="hm-path-desc">Free tool for HIPAA nonprofits. Answer five questions about your org and the vendor. Get a right-sized security questionnaire based on SIG, CAIQ, and HIPAA frameworks.</p>
          <span class="hm-path-link">
            Open the tool
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>

      </div>
    </div>
  </section>

  <!-- ══ CREDIBILITY ════════════════════════════════════════════════════════ -->
  <section class="hm-cred">
    <div class="container">
      <div class="hm-cred-grid">
        <div class="hm-cred-stat">
          <span class="hm-cred-value display">8&ndash;12</span>
          <span class="hm-cred-label">recoverable staff hours found in a first assessment</span>
        </div>
        <div class="hm-cred-stat">
          <span class="hm-cred-value display">24 hrs</span>
          <span class="hm-cred-label">from Capacity Review call to written Operations Assessment in your inbox</span>
        </div>
        <div class="hm-cred-stat">
          <span class="hm-cred-value display">12 min</span>
          <span class="hm-cred-label">call length — no prep, no pitch, no commitment required</span>
        </div>
        <div class="hm-cred-stat">
          <span class="hm-cred-value display">HIPAA</span>
          <span class="hm-cred-label">we only deploy tools that meet HIPAA standards — every engagement, no exceptions</span>
        </div>
      </div>
      <p class="hm-cred-footnote mono">
        Staff-hours baseline drawn from clinical workflow research.
        <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC5593724/" target="_blank" rel="noopener noreferrer">Based on clinical research &rarr;</a>
      </p>
    </div>
  </section>

  <!-- ══ BOTTOM CTA ══════════════════════════════════════════════════════════ -->
  <section class="hm-bottom-cta">
    <div class="container hm-bottom-cta-inner">
      <h2 class="hm-bottom-cta-h2 display">
        12 minutes.<br>
        <em>Written report in 24 hours.</em>
      </h2>
      <p class="hm-bottom-cta-sub">No pitch on the call. No commitment after. Just your three biggest bottlenecks, ranked by recoverable hours.</p>
      <a href="/capacity-review" class="btn-pill btn-pill--lg">
        Start Your Capacity Review
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>

<!-- ══ SPHERE ANIMATION (ASCII character sphere — matches site visual language) ════ -->
<script is:inline>
(function () {
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  /* ── SPHERE (hero background) ── */
  (function () {
    var canvas = document.getElementById('sphereCanvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) return;
    var chars = '░▒▓█▀▄▌▐│─┤├┴┬╭╮╰╯';
    var time = 0;
    var rafId = null;
    function resize() {
      var dpr = window.devicePixelRatio || 1;
      var rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);
    }
    resize();
    window.addEventListener('resize', resize);
    function render() {
      var rect = canvas.getBoundingClientRect();
      ctx.clearRect(0, 0, rect.width, rect.height);
      var cx = rect.width / 2, cy = rect.height / 2;
      var radius = Math.min(rect.width, rect.height) * 0.525;
      ctx.font = '12px monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      var points = [];
      for (var phi = 0; phi < Math.PI * 2; phi += 0.15) {
        for (var theta = 0; theta < Math.PI; theta += 0.15) {
          var x = Math.sin(theta) * Math.cos(phi + time * 0.5);
          var y = Math.sin(theta) * Math.sin(phi + time * 0.5);
          var z = Math.cos(theta);
          var ry = time * 0.3;
          var nx = x * Math.cos(ry) - z * Math.sin(ry);
          var nz = x * Math.sin(ry) + z * Math.cos(ry);
          var rx = time * 0.2;
          var ny = y * Math.cos(rx) - nz * Math.sin(rx);
          var fz = y * Math.sin(rx) + nz * Math.cos(rx);
          var depth = (fz + 1) / 2;
          var ci = Math.floor(depth * (chars.length - 1));
          points.push({ x: cx + nx * radius, y: cy + ny * radius, z: fz, ch: chars[ci] });
        }
      }
      points.sort(function (a, b) { return a.z - b.z; });
      points.forEach(function (p) {
        var isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        ctx.fillStyle = isDark
          ? 'rgba(248,245,240,' + (0.2 + (p.z + 1) * 0.4) + ')'
          : 'rgba(0,0,0,' + (0.2 + (p.z + 1) * 0.4) + ')';
        ctx.fillText(p.ch, p.x, p.y);
      });
      time += 0.005;
      rafId = requestAnimationFrame(render);
    }
    if ('IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting) { if (!rafId) render(); }
        else { cancelAnimationFrame(rafId); rafId = null; }
      }, { rootMargin: '50px' });
      obs.observe(canvas);
    } else { render(); }
  })();

})();
</script>

<style>
/* ══ HOMEPAGE SCOPED STYLES ══════════════════════════════════════════════════ */

/* ── HERO ─────────────────────────────────────────────────────────────────── */
.hm-hero {
  position: relative;
  padding: 140px 0 100px;
  overflow: visible; /* sphere bleeds freely — body overflow-x:hidden handles horizontal */
  border-bottom: 1px solid var(--border);
}

.hm-hero-sphere {
  position: absolute;
  right: -60px;
  top: 0;           /* starts at section top = overlaps transparent nav area */
  transform: none;
  width: 600px;
  height: 600px;
  opacity: 0.75;
  pointer-events: none;
}

@media (min-width: 1024px) {
  .hm-hero-sphere { width: 800px; height: 800px; right: -80px; }
}

@media (max-width: 768px) {
  .hm-hero-sphere { width: 360px; height: 360px; right: -60px; top: 0; transform: none; opacity: 0.5; }
}

.hm-hero-sphere canvas { width: 100%; height: 100%; display: block; }

.hm-hero-inner { position: relative; z-index: 1; max-width: 640px; }

.hm-eyebrow {
  display: block;
  font-size: var(--text-xs, 0.6875rem);
  color: var(--text-faint);
  letter-spacing: 0.04em;
  margin-bottom: 20px;
  line-height: 1.5;
}

.hm-h1 {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 400;
  line-height: 1.08;
  letter-spacing: -0.02em;
  margin-bottom: 24px;
  color: var(--fg);
}

.hm-h1 em {
  font-style: italic;
  color: var(--green);
}

.hm-sub {
  font-size: 1.0625rem;
  color: var(--text-muted);
  line-height: 1.65;
  max-width: 520px;
  margin-bottom: 36px;
}

.hm-ctas {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 32px;
}

.hm-trust-strip {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.hm-trust-item {
  font-size: var(--text-xs, 0.6875rem);
  color: var(--text-faint);
  letter-spacing: 0.03em;
}

.hm-trust-dot {
  font-size: 0.5rem;
  color: var(--border-mid);
}

/* ── SECTION SHARED ───────────────────────────────────────────────────────── */
.hm-section-h2 {
  font-size: clamp(1.75rem, 3.5vw, 2.5rem);
  font-weight: 400;
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin: 8px 0 16px;
  color: var(--fg);
}

.hm-section-sub {
  font-size: 1rem;
  color: var(--text-muted);
  max-width: 540px;
  line-height: 1.65;
  margin-bottom: 40px;
}

/* ── WHO IT'S FOR ─────────────────────────────────────────────────────────── */
.hm-qualify {
  padding: var(--s-section) 0;
  border-bottom: 1px solid var(--border);
}

.hm-qualify-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

@media (max-width: 680px) {
  .hm-qualify-grid { grid-template-columns: 1fr; }
}

.hm-qualify-card {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 28px;
}

.hm-qualify-yes { border-left: 3px solid var(--green); }
.hm-qualify-no  { border-left: 3px solid var(--border-mid); }

.hm-qualify-label {
  display: block;
  font-size: var(--text-xs, 0.6875rem);
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--text-faint);
  margin-bottom: 16px;
}

.hm-qualify-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.hm-qualify-yes .hm-qualify-list li {
  padding: 7px 0 7px 22px;
  position: relative;
  font-size: 0.875rem;
  color: var(--fg);
  border-bottom: 1px solid var(--border);
  line-height: 1.5;
}

.hm-qualify-yes .hm-qualify-list li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--green);
  font-weight: 600;
  font-size: 0.75rem;
}

.hm-qualify-no .hm-qualify-list li {
  padding: 7px 0 7px 22px;
  position: relative;
  font-size: 0.875rem;
  color: var(--text-muted);
  border-bottom: 1px solid var(--border);
  line-height: 1.5;
}

.hm-qualify-no .hm-qualify-list li::before {
  content: '✕';
  position: absolute;
  left: 0;
  color: var(--text-faint);
  font-size: 0.75rem;
}

.hm-qualify-list li:last-child { border-bottom: none; }

/* ── THREE PATHS ──────────────────────────────────────────────────────────── */
.hm-paths {
  padding: var(--s-section) 0;
  border-bottom: 1px solid var(--border);
}

.hm-paths-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

@media (max-width: 860px) {
  .hm-paths-grid { grid-template-columns: 1fr; max-width: 480px; }
}

.hm-path-card {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 28px;
  text-decoration: none;
  color: var(--fg);
  transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  cursor: pointer;
}

.hm-path-card:hover {
  border-color: var(--green);
  box-shadow: 0 4px 20px oklch(49% 0.12 244 / 0.12);
  transform: translateY(-2px);
}

.hm-path-primary {
  background: var(--green-pale, oklch(95% 0.015 252));
  border-color: var(--green);
}

.hm-path-icon {
  width: 36px;
  height: 36px;
  color: var(--green);
  margin-bottom: 16px;
}

.hm-path-icon svg { width: 100%; height: 100%; }

.hm-path-tag {
  font-size: var(--text-xs, 0.6875rem);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-faint);
  margin-bottom: 8px;
}

.hm-path-primary .hm-path-tag { color: var(--green-mid); }

.hm-path-title {
  font-size: 1.0625rem;
  font-weight: 600;
  line-height: 1.3;
  margin-bottom: 12px;
  color: var(--fg);
}

.hm-path-desc {
  font-size: 0.875rem;
  color: var(--text-muted);
  line-height: 1.6;
  flex: 1;
  margin-bottom: 20px;
}

.hm-path-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--green);
  margin-top: auto;
}

/* ── CREDIBILITY ──────────────────────────────────────────────────────────── */
.hm-cred {
  padding: var(--s-section) 0;
  border-bottom: 1px solid var(--border);
  background: var(--bg-subtle);
}

.hm-cred-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
  margin-bottom: 24px;
}

@media (max-width: 860px) {
  .hm-cred-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 480px) {
  .hm-cred-grid { grid-template-columns: 1fr; }
}

.hm-cred-stat {
  border-left: 2px solid var(--green);
  padding-left: 20px;
}

.hm-cred-value {
  display: block;
  font-size: clamp(1.75rem, 3vw, 2.25rem);
  font-weight: 400;
  color: var(--fg);
  line-height: 1.1;
  margin-bottom: 8px;
}

.hm-cred-label {
  display: block;
  font-size: 0.8125rem;
  color: var(--text-muted);
  line-height: 1.55;
}

.hm-cred-footnote {
  font-size: var(--text-xs, 0.6875rem);
  color: var(--text-faint);
}

.hm-cred-footnote a {
  color: var(--green);
  text-decoration: none;
}

.hm-cred-footnote a:hover { text-decoration: underline; }

/* ── BOTTOM CTA ───────────────────────────────────────────────────────────── */
.hm-bottom-cta {
  padding: var(--s-section) 0;
  background: var(--brand-navy, #171E62);
}

.hm-bottom-cta-inner {
  text-align: center;
  max-width: 560px;
  margin: 0 auto;
}

.hm-bottom-cta-h2 {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--fg-dark, oklch(97% 0.007 78));
  margin-bottom: 16px;
}

.hm-bottom-cta-h2 em {
  font-style: italic;
  color: var(--green-bright, oklch(67% 0.10 228));
}

.hm-bottom-cta-sub {
  font-size: 1rem;
  color: var(--fg-dark-muted, oklch(97% 0.007 78 / 0.6));
  line-height: 1.65;
  margin-bottom: 32px;
}

/* Dark mode adjustments */
@media (prefers-color-scheme: dark) {
  .hm-qualify-card { background: var(--bg-subtle); }
  .hm-path-primary { background: oklch(20% 0.015 244 / 0.4); }
  .hm-cred { background: var(--bg-subtle); }
}
</style>
