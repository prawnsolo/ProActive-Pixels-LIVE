---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import libraryData from '../data/questionnaire-library.json';

const TIERS = {
  lite:       { label: 'Lite',        desc: 'Low-risk vendor — limited data access, no system connectivity',        color: '#1770B2', qs: '22–30 questions' },
  standard:   { label: 'Standard',    desc: 'Medium-risk vendor — stores data, supports key operations',            color: '#2A88CC', qs: '45–65 questions' },
  hipaa_full: { label: 'HIPAA Full',  desc: 'High-risk vendor — PHI access or privileged system access',           color: '#C9A84C', qs: '70–95 questions' },
};
---

<BaseLayout
  title="Vendor Security Questionnaire Builder | ProActive Pixels"
  description="Build a right-sized vendor security questionnaire in minutes. Auto-scores risk, adds HIPAA branching, and generates a print-ready document based on SIG, CAIQ, and HIPAA frameworks."
  canonical="https://proactivepixels.com/vendor-security"
>
  <Nav />

  <!-- ══ PAGE HERO ═════════════════════════════════════════════════════════ -->
  <section class="vs-hero" id="vs-top">
    <div class="container">
      <div class="vs-hero-inner">
        <p class="section-label">Vendor Risk Management</p>
        <h1 class="vs-headline display">Build a vendor security<br><em>questionnaire that fits</em></h1>
        <p class="vs-subhead">Right-sized for nonprofits. Grounded in SIG, CSA CAIQ, and HIPAA frameworks.<br>Answer five questions and get a questionnaire you can send today.</p>

        <div class="vs-how-strip">
          <div class="vs-how-item">
            <span class="vs-how-num mono">01</span>
            <span class="vs-how-text">Describe your org and the vendor</span>
          </div>
          <div class="vs-how-arrow" aria-hidden="true">→</div>
          <div class="vs-how-item">
            <span class="vs-how-num mono">02</span>
            <span class="vs-how-text">Risk score calculated automatically</span>
          </div>
          <div class="vs-how-arrow" aria-hidden="true">→</div>
          <div class="vs-how-item">
            <span class="vs-how-num mono">03</span>
            <span class="vs-how-text">Preview and export your questionnaire</span>
          </div>
        </div>

        <div class="vs-trust-strip">
          <span class="vs-trust-item mono">SIG / SIGLite</span>
          <span class="vs-trust-dot" aria-hidden="true">·</span>
          <span class="vs-trust-item mono">CSA CAIQ</span>
          <span class="vs-trust-dot" aria-hidden="true">·</span>
          <span class="vs-trust-item mono">VSA Lite</span>
          <span class="vs-trust-dot" aria-hidden="true">·</span>
          <span class="vs-trust-item mono">HIPAA Security Rule</span>
        </div>

        <div class="vs-phi-notice">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Do not enter protected health information (PHI) or patient data into this tool.
        </div>

        <a href="#vs-builder" class="btn-pill btn-pill--lg vs-start-btn">
          Start the Builder
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ══ TIER EXPLAINER ════════════════════════════════════════════════════ -->
  <section class="vs-tiers">
    <div class="container">
      <p class="section-label centered">Risk Tiers</p>
      <div class="vs-tier-cards">
        {Object.entries(TIERS).map(([key, t]) => (
          <div class={`vs-tier-card vs-tier-card--${key}`}>
            <span class="vs-tier-badge mono">{t.label}</span>
            <p class="vs-tier-desc">{t.desc}</p>
            <span class="vs-tier-qs mono">{t.qs}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ WIZARD ════════════════════════════════════════════════════════════ -->
  <section class="vs-builder-section" id="vs-builder">
    <div class="container">
      <div class="vs-builder-wrap">

        <div class="quiz-wrap" id="vsQuiz" role="form" aria-label="Vendor security questionnaire builder">

          <!-- Header Bar -->
          <div class="quiz-header-bar">
            <div>
              <p class="quiz-header-title">Questionnaire Builder</p>
              <p class="quiz-header-sub" id="vsStepLabel">Step 1 of 5 — Organization Context</p>
            </div>
            <div class="quiz-progress-bar" role="progressbar" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100" aria-label="Builder progress">
              <div class="quiz-progress-fill" id="vsProgressFill" style="transform:scaleX(0.20)"></div>
            </div>
          </div>

          <!-- Body -->
          <div class="quiz-body">

            <!-- ── STEP 1: Organization Context ── -->
            <div class="quiz-step active" id="vs-step-1" data-step="1">
              <p class="quiz-step-label">Step 1 of 5</p>
              <h2 class="quiz-question display">Tell us about your organization and this review</h2>
              <p class="vs-step-intro">This information will appear on the cover page of the questionnaire you send to the vendor.</p>

              <div class="vs-form-grid">
                <div class="form-group">
                  <label for="vsOrgName">Organization name <span class="vs-required" aria-label="required">*</span></label>
                  <input type="text" id="vsOrgName" name="org_name" placeholder="Community Health Center of the Valley" autocomplete="organization" required>
                </div>
                <div class="form-group">
                  <label for="vsContactName">Your name <span class="vs-required" aria-label="required">*</span></label>
                  <input type="text" id="vsContactName" name="contact_name" placeholder="Jane Smith" autocomplete="name" required>
                </div>
                <div class="form-group">
                  <label for="vsEmail">Your email <span class="vs-required" aria-label="required">*</span></label>
                  <input type="email" id="vsEmail" name="email" placeholder="jane@org.org" autocomplete="email" required>
                </div>
                <div class="form-group">
                  <label for="vsReviewDate">Requested vendor response date</label>
                  <input type="date" id="vsReviewDate" name="review_date">
                </div>
              </div>

              <p class="quiz-step-label" style="margin-top:24px;margin-bottom:10px;">What type of review is this?</p>
              <div class="quiz-options" id="vsAssessmentType" role="radiogroup" aria-label="Assessment type">
                <button class="quiz-option" data-group="assessment_type" data-value="new_vendor" type="button">
                  <span class="quiz-option-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg></span>
                  <span><span class="quiz-option-text">New vendor review</span><span class="quiz-option-sub">Evaluating a vendor for the first time</span></span>
                </button>
                <button class="quiz-option" data-group="assessment_type" data-value="renewal" type="button">
                  <span class="quiz-option-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg></span>
                  <span><span class="quiz-option-text">Contract renewal</span><span class="quiz-option-sub">Re-evaluating an existing vendor at renewal</span></span>
                </button>
                <button class="quiz-option" data-group="assessment_type" data-value="periodic" type="button">
                  <span class="quiz-option-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span>
                  <span><span class="quiz-option-text">Periodic reassessment</span><span class="quiz-option-sub">Scheduled annual or routine review</span></span>
                </button>
              </div>

              <div class="quiz-nav">
                <button class="btn-next" id="vsNext1" type="button" aria-label="Go to step 2">
                  Next: Vendor Profile
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>
              </div>
            </div>

            <!-- ── STEP 2: Vendor Profile ── -->
            <div class="quiz-step" id="vs-step-2" data-step="2">
              <p class="quiz-step-label">Step 2 of 5</p>
              <h2 class="quiz-question display">Tell us about the vendor</h2>

              <div class="form-group" style="margin-bottom:20px;">
                <label for="vsVendorName">Vendor name <span class="vs-required" aria-label="required">*</span></label>
                <input type="text" id="vsVendorName" name="vendor_name" placeholder="Acme Software Inc." required>
              </div>

              <p class="quiz-step-label" style="margin-bottom:10px;">What best describes this vendor's role?</p>
              <div class="quiz-options" id="vsVendorCategory" role="radiogroup" aria-label="Vendor category" style="margin-bottom:20px;">
                <button class="quiz-option" data-group="vendor_category" data-value="software_saas" type="button">
                  <span class="quiz-option-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></span>
                  <span><span class="quiz-option-text">Software / SaaS platform</span></span>
                </button>
                <button class="quiz-option" data-group="vendor_category" data-value="it_services" type="button">
                  <span class="quiz-option-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg></span>
                  <span><span class="quiz-option-text">IT services or managed services</span></span>
                </button>
                <button class="quiz-option" data-group="vendor_category" data-value="billing_rcm" type="button">
                  <span class="quiz-option-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 1 0 0 7h5a3.5 3.5 0 1 1 0 7H6"/></svg></span>
                  <span><span class="quiz-option-text">Billing or revenue cycle management</span></span>
                </button>
                <button class="quiz-option" data-group="vendor_category" data-value="ehr_clinical" type="button">
                  <span class="quiz-option-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></span>
                  <span><span class="quiz-option-text">EHR-related or clinical software</span></span>
                </button>
                <button class="quiz-option" data-group="vendor_category" data-value="consultant" type="button">
                  <span class="quiz-option-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
                  <span><span class="quiz-option-text">Consulting / advisory / staffing</span></span>
                </button>
                <button class="quiz-option" data-group="vendor_category" data-value="other" type="button">
                  <span class="quiz-option-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></span>
                  <span><span class="quiz-option-text">Other</span></span>
                </button>
              </div>

              <p class="quiz-step-label" style="margin-bottom:10px;">How is the service delivered?</p>
              <div class="quiz-options" id="vsDeployment" role="radiogroup" aria-label="Deployment type" style="margin-bottom:20px;">
                <button class="quiz-option" data-group="deployment" data-value="cloud" type="button">
                  <span><span class="quiz-option-text">Cloud-based / SaaS</span><span class="quiz-option-sub">Hosted externally; accessed via browser or API</span></span>
                </button>
                <button class="quiz-option" data-group="deployment" data-value="on_premises" type="button">
                  <span><span class="quiz-option-text">On-premises software</span><span class="quiz-option-sub">Installed and runs on your own infrastructure</span></span>
                </button>
                <button class="quiz-option" data-group="deployment" data-value="service_only" type="button">
                  <span><span class="quiz-option-text">Service-only (no software component)</span><span class="quiz-option-sub">Human-delivered service; no software to install or access</span></span>
                </button>
                <button class="quiz-option" data-group="deployment" data-value="hybrid" type="button">
                  <span><span class="quiz-option-text">Hybrid (cloud + on-premises)</span></span>
                </button>
              </div>

              <p class="quiz-step-label" style="margin-bottom:10px;">Will this vendor store your organization's data on their systems?</p>
              <div class="quiz-options vs-yn-options" id="vsStoresData" role="radiogroup" aria-label="Vendor data storage">
                <button class="quiz-option" data-group="stores_data" data-value="yes" type="button">
                  <span><span class="quiz-option-text">Yes — they will store our data</span></span>
                </button>
                <button class="quiz-option" data-group="stores_data" data-value="no" type="button">
                  <span><span class="quiz-option-text">No — no data storage on their side</span></span>
                </button>
                <button class="quiz-option" data-group="stores_data" data-value="unsure" type="button">
                  <span><span class="quiz-option-text">Not sure yet</span></span>
                </button>
              </div>

              <p class="quiz-step-label" style="margin-top:16px;margin-bottom:10px;">Will this vendor connect to your internal systems or network?</p>
              <div class="quiz-options vs-yn-options" id="vsConnectsInternal" role="radiogroup" aria-label="Internal system connectivity">
                <button class="quiz-option" data-group="connects_internal" data-value="yes" type="button">
                  <span><span class="quiz-option-text">Yes — direct connection, VPN, or API integration</span></span>
                </button>
                <button class="quiz-option" data-group="connects_internal" data-value="no" type="button">
                  <span><span class="quiz-option-text">No — standalone, no system integration</span></span>
                </button>
                <button class="quiz-option" data-group="connects_internal" data-value="unsure" type="button">
                  <span><span class="quiz-option-text">Not sure yet</span></span>
                </button>
              </div>

              <div class="quiz-nav">
                <button class="vs-btn-back" id="vsBack2" type="button">← Back</button>
                <button class="btn-next" id="vsNext2" type="button">
                  Next: Data & HIPAA
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>
              </div>
            </div>

            <!-- ── STEP 3: Data & HIPAA Triggers ── -->
            <div class="quiz-step" id="vs-step-3" data-step="3">
              <p class="quiz-step-label">Step 3 of 5</p>
              <h2 class="quiz-question display">What data will this vendor handle?</h2>
              <p class="vs-step-intro">These answers determine whether HIPAA-specific review applies.</p>

              <!-- HIPAA Warning Banner — shown conditionally -->
              <div class="vs-hipaa-banner" id="vsHipaaBanner" role="alert" aria-live="polite" hidden>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <div>
                  <strong>HIPAA review required.</strong> Vendors that create, receive, maintain, or transmit protected health information (PHI) generally require a Business Associate Agreement (BAA) and a more comprehensive security review. Confirm BAA requirements with your compliance or legal team before sharing PHI with this vendor.
                </div>
              </div>

              <p class="quiz-step-label" style="margin-bottom:10px;">Will this vendor create, receive, maintain, transmit, or otherwise access protected health information (PHI)?</p>
              <div class="vs-tooltip-anchor">
                <span class="vs-tooltip-trigger">What counts as PHI?</span>
                <span class="vs-tooltip-body" role="tooltip">PHI includes any individually identifiable health information in any format — names, dates, addresses, diagnoses, treatment records, billing codes, or health plan numbers — when tied to a patient or plan member.</span>
              </div>
              <div class="quiz-options vs-yn-options" id="vsPhiAccess" role="radiogroup" aria-label="PHI access" style="margin-top:10px;">
                <button class="quiz-option" data-group="phi_access" data-value="yes" type="button">
                  <span><span class="quiz-option-text">Yes — they will have access to PHI</span></span>
                </button>
                <button class="quiz-option" data-group="phi_access" data-value="no" type="button">
                  <span><span class="quiz-option-text">No — no PHI involved</span></span>
                </button>
                <button class="quiz-option" data-group="phi_access" data-value="unsure" type="button">
                  <span><span class="quiz-option-text">Not sure — treat as yes to be safe</span></span>
                </button>
              </div>

              <p class="quiz-step-label" style="margin-top:20px;margin-bottom:10px;">Is a Business Associate Agreement (BAA) expected or required for this vendor?</p>
              <div class="vs-tooltip-anchor">
                <span class="vs-tooltip-trigger">What is a BAA?</span>
                <span class="vs-tooltip-body" role="tooltip">A Business Associate Agreement is a legally binding contract required by HIPAA between a Covered Entity (your org) and any vendor (Business Associate) that handles PHI on your behalf. Without a BAA, sharing PHI with a vendor may be a HIPAA violation.</span>
              </div>
              <div class="quiz-options vs-yn-options" id="vsBaaExpected" role="radiogroup" aria-label="BAA expected" style="margin-top:10px;">
                <button class="quiz-option" data-group="baa_expected" data-value="yes" type="button"><span><span class="quiz-option-text">Yes</span></span></button>
                <button class="quiz-option" data-group="baa_expected" data-value="no" type="button"><span><span class="quiz-option-text">No</span></span></button>
                <button class="quiz-option" data-group="baa_expected" data-value="unsure" type="button"><span><span class="quiz-option-text">Need to confirm</span></span></button>
              </div>

              <p class="quiz-step-label" style="margin-top:20px;margin-bottom:10px;">Does this vendor use subcontractors or subprocessors that may also access your data?</p>
              <div class="quiz-options vs-yn-options" id="vsHasSubcontractors" role="radiogroup" aria-label="Subcontractors">
                <button class="quiz-option" data-group="has_subcontractors" data-value="yes" type="button"><span><span class="quiz-option-text">Yes</span></span></button>
                <button class="quiz-option" data-group="has_subcontractors" data-value="no" type="button"><span><span class="quiz-option-text">No</span></span></button>
                <button class="quiz-option" data-group="has_subcontractors" data-value="unsure" type="button"><span><span class="quiz-option-text">Not sure</span></span></button>
              </div>

              <p class="quiz-step-label" style="margin-top:20px;margin-bottom:10px;">Does this vendor handle regulated financial, donor, employee, or student data?</p>
              <div class="quiz-options vs-yn-options" id="vsRegulatedFinancial" role="radiogroup" aria-label="Regulated financial data">
                <button class="quiz-option" data-group="regulated_financial" data-value="yes" type="button"><span><span class="quiz-option-text">Yes</span></span></button>
                <button class="quiz-option" data-group="regulated_financial" data-value="no" type="button"><span><span class="quiz-option-text">No</span></span></button>
                <button class="quiz-option" data-group="regulated_financial" data-value="unsure" type="button"><span><span class="quiz-option-text">Not sure</span></span></button>
              </div>

              <div class="quiz-nav">
                <button class="vs-btn-back" id="vsBack3" type="button">← Back</button>
                <button class="btn-next" id="vsNext3" type="button">
                  Next: Security Depth
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>
              </div>
            </div>

            <!-- ── STEP 4: Security Depth ── -->
            <div class="quiz-step" id="vs-step-4" data-step="4">
              <p class="quiz-step-label">Step 4 of 5</p>
              <h2 class="quiz-question display">How critical is this vendor to your operations?</h2>

              <p class="quiz-step-label" style="margin-bottom:10px;">Is this vendor operationally critical — would your team be unable to deliver services without them?</p>
              <div class="quiz-options vs-yn-options" id="vsOpCritical" role="radiogroup" aria-label="Operational criticality">
                <button class="quiz-option" data-group="operationally_critical" data-value="yes" type="button"><span><span class="quiz-option-text">Yes — essential to daily operations</span></span></button>
                <button class="quiz-option" data-group="operationally_critical" data-value="no" type="button"><span><span class="quiz-option-text">No — non-essential or easily replaceable</span></span></button>
                <button class="quiz-option" data-group="operationally_critical" data-value="partial" type="button"><span><span class="quiz-option-text">Partially — important but not mission-critical</span></span></button>
              </div>

              <p class="quiz-step-label" style="margin-top:20px;margin-bottom:10px;">Would extended downtime from this vendor affect care delivery, donor operations, or finance?</p>
              <div class="quiz-options vs-yn-options" id="vsDowntimeImpact" role="radiogroup" aria-label="Downtime impact">
                <button class="quiz-option" data-group="downtime_impact" data-value="yes" type="button"><span><span class="quiz-option-text">Yes</span></span></button>
                <button class="quiz-option" data-group="downtime_impact" data-value="no" type="button"><span><span class="quiz-option-text">No</span></span></button>
              </div>

              <p class="quiz-step-label" style="margin-top:20px;margin-bottom:10px;">Does this vendor have or require privileged or administrator access to your systems?</p>
              <div class="vs-tooltip-anchor">
                <span class="vs-tooltip-trigger">What is privileged access?</span>
                <span class="vs-tooltip-body" role="tooltip">Privileged access means the vendor can install software, modify system settings, access databases directly, or perform actions beyond normal user permissions on your infrastructure.</span>
              </div>
