.vs-faq-a { padding-bottom: 18px; font-size: var(--text-sm); color: var(--text-muted); line-height: var(--lh-body); }

/* ── PRINT CSS ──────────────────────────────────────────────────────────── */
@media print {
  #nav, .sticky-mobile-cta, .vs-hero, .vs-tiers,
  .vs-builder-section, .vs-faq,
  .vs-preview-actions, .vs-summary-card, .vs-cr-cta { display: none !important; }

  .vs-preview-section { padding: 0 !important; }
