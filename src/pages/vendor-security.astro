.vs-doc-cover-meta { margin-top: 20px; display: flex; gap: 32px; flex-wrap: wrap; position: relative; z-index: 1; }
.vs-doc-cover-meta-item { display: flex; flex-direction: column; gap: 3px; }
.vs-doc-cover-meta-label { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: .1em; text-transform: uppercase; color: oklch(97% 0.007 78 / .35); }
.vs-doc-cover-meta-val { font-size: var(--text-sm); color: oklch(97% 0.007 78 / .85); }

.vs-doc-domain { margin-bottom: 40px; }
.vs-doc-domain-header {
  display: flex; align-items: center; gap: 12px;
  padding-bottom: 10px; margin-bottom: 20px;
