.vs-doc-question { padding: 16px 0; border-bottom: 1px solid oklch(18% 0.012 78 / .06); }
.vs-doc-question:last-child { border-bottom: none; }
.vs-doc-q-num { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-faint); margin-bottom: 4px; }
.vs-doc-q-text { font-size: var(--text-base); color: var(--fg); line-height: var(--lh-body); font-weight: 500; margin-bottom: 6px; }
.vs-doc-q-helper { font-size: var(--text-sm); color: var(--text-muted); line-height: var(--lh-body); margin-bottom: 8px; font-style: italic; }
.vs-doc-q-evidence { font-size: var(--text-xs); color: var(--green-mid); font-family: var(--font-mono); margin-bottom: 8px; }
.vs-doc-q-evidence::before { content: "Evidence: "; color: var(--text-faint); }
.vs-doc-response { width: 100%; margin-top: 8px; background: var(--bg-subtle); border: 1px solid var(--border); border-radius: var(--r-sm); padding: 10px 12px; min-height: 48px; font-size: var(--text-sm); color: var(--text-muted); font-style: italic; }
.vs-doc-hipaa-flag { display: inline-flex; align-items: center; gap: 5px; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--gold); letter-spacing: .08em; text-transform: uppercase; margin-left: 8px; }

/* ── FAQ ────────────────────────────────────────────────────────────────── */
.vs-faq { padding: var(--s-section) 0; border-top: 1px solid var(--border); }
.vs-faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 40px; margin-top: 40px; }
@media (max-width: 768px) { .vs-faq-grid { grid-template-columns: 1fr; } }
.vs-faq-item { border-bottom: 1px solid var(--border); }
.vs-faq-q {
