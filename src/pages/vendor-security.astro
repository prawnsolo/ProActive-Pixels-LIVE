<script is:inline define:vars={{ libraryData }}>
// ─── DATA ───────────────────────────────────────────────────────────────────
const LIBRARY = libraryData;

// ─── STATE ──────────────────────────────────────────────────────────────────
const state = {
  org_name: '', contact_name: '', email: '',
  assessment_type: '', review_date: '',
  vendor_name: '', vendor_category: '', deployment: '',
  stores_data: '', connects_internal: '',
  phi_access: '', baa_expected: '', has_subcontractors: '', regulated_financial: '',
  operationally_critical: '', downtime_impact: '', privileged_access: '',
  include_notes: true, include_response_col: true, evidence_prompts: false,
  next_review_date: '', email_delivery: '', save_profile: false,
  tier: 'lite', tier_override: null,
};

const STEP_LABELS = [
  '',
  'Step 1 of 5 — Organization Context',
  'Step 2 of 5 — Vendor Profile',
  'Step 3 of 5 — Data & HIPAA',
  'Step 4 of 5 — Security Depth',
  'Step 5 of 5 — Export Options',
];
const PROGRESS = [0, 0.20, 0.40, 0.60, 0.80, 1.0];

// ─── STEP MANAGEMENT ────────────────────────────────────────────────────────
let currentStep = 1;

function goToStep(n) {
  document.getElementById('vs-step-' + currentStep).classList.remove('active');
  currentStep = n;
  document.getElementById('vs-step-' + n).classList.add('active');
  document.getElementById('vsProgressFill').style.transform = 'scaleX(' + PROGRESS[n] + ')';
  document.getElementById('vsProgressFill').parentElement.setAttribute('aria-valuenow', Math.round(PROGRESS[n] * 100));
  document.getElementById('vsStepLabel').textContent = STEP_LABELS[n];
  document.getElementById('vsQuiz').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ─── OPTION SELECTION ───────────────────────────────────────────────────────
function setupOptionGroup(containerId, stateKey, onChangeCallback) {
  const container = document.getElementById(containerId);
  if (!container) return;
  container.querySelectorAll('.quiz-option[data-group]').forEach(btn => {
    btn.addEventListener('click', function() {
      container.querySelectorAll('.quiz-option').forEach(b => b.classList.remove('selected'));
      this.classList.add('selected');
      state[stateKey] = this.dataset.value;
      checkNextButtons();
      if (onChangeCallback) onChangeCallback(this.dataset.value);
    });
  });
}

function checkNextButtons() {
  // Step 1: need org_name, contact_name, email, assessment_type filled
  const s1ok = state.org_name.trim() && state.contact_name.trim() && state.email.trim() && state.assessment_type;
  document.getElementById('vsNext1').classList.toggle('on', !!s1ok);

  // Step 2: need vendor_name, vendor_category, deployment, stores_data, connects_internal
  const s2ok = state.vendor_name.trim() && state.vendor_category && state.deployment && state.stores_data && state.connects_internal;
  document.getElementById('vsNext2').classList.toggle('on', !!s2ok);

  // Step 3: need phi_access, baa_expected, has_subcontractors, regulated_financial
  const s3ok = state.phi_access && state.baa_expected && state.has_subcontractors && state.regulated_financial;
  document.getElementById('vsNext3').classList.toggle('on', !!s3ok);

  // Step 4: need operationally_critical, downtime_impact, privileged_access
  const s4ok = state.operationally_critical && state.downtime_impact && state.privileged_access;
  if (s4ok) {
    computeAndShowTier();
    document.getElementById('vsNext4').classList.add('on');
  } else {
    document.getElementById('vsNext4').classList.remove('on');
  }
}

// ─── TEXT FIELD LISTENERS ────────────────────────────────────────────────────
function setupTextField(id, stateKey) {
  const el = document.getElementById(id);
  if (!el) return;
  el.addEventListener('input', () => { state[stateKey] = el.value; checkNextButtons(); });
}

// ─── HIPAA BRANCHING ────────────────────────────────────────────────────────
function onPhiChange(val) {
  const banner = document.getElementById('vsHipaaBanner');
  if (val === 'yes' || val === 'unsure') {
    banner.hidden = false;
    banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  } else {
    banner.hidden = true;
  }
}

// ─── RISK SCORING ────────────────────────────────────────────────────────────
function computeRiskScore() {
  let score = 0;
  const yesVal = v => v === 'yes' || v === 'unsure';

  // High-weight (3 pts)
  if (yesVal(state.phi_access))             score += 3;
  if (yesVal(state.privileged_access))      score += 3;
  if (yesVal(state.connects_internal))      score += 3;
  if (state.stores_data === 'yes')          score += 2;
  if (yesVal(state.operationally_critical)) score += 3;

  // Medium-weight (2 pts)
  if (yesVal(state.has_subcontractors))     score += 2;
  if (state.deployment === 'cloud')         score += 1;
  if (yesVal(state.downtime_impact))        score += 2;
  if (yesVal(state.regulated_financial))    score += 2;

  return score;
}

function computeAndShowTier() {
  const score = computeRiskScore();
  const phiAccess = state.phi_access === 'yes' || state.phi_access === 'unsure';

  let tier = 'lite';
  let reason = '';

  if (phiAccess || score >= 9) {
    tier = 'hipaa_full';
    reason = phiAccess
      ? 'This vendor may access protected health information (PHI). HIPAA Full tier includes all required HIPAA controls, BAA review, and breach notification questions.'
      : 'Multiple high-weight risk factors indicate this vendor requires comprehensive review (score ' + score + '/20).';
  } else if (score >= 4) {
    tier = 'standard';
    reason = 'This vendor has elevated risk factors — data storage, system connectivity, or operational criticality — that warrant a Standard review (score ' + score + '/20).';
  } else {
    tier = 'lite';
    reason = 'This vendor has limited data access and low connectivity. A Lite questionnaire covers the essential baseline (score ' + score + '/20).';
  }

  state.tier = tier;

  const tierLabels = { lite: 'Lite', standard: 'Standard', hipaa_full: 'HIPAA Full' };
  const tierColors = { lite: 'var(--green)', standard: 'var(--green-mid)', hipaa_full: 'var(--gold)' };

  const badge = document.getElementById('vsTierBadge');
  badge.innerHTML = '<span class="tier-dot" style="background:' + tierColors[tier] + '"></span>' + tierLabels[tier] + ' Tier Recommended';
  badge.style.color = tierColors[tier];

  document.getElementById('vsTierReason').textContent = reason;

  // Pre-select the matching override radio
  const overrideRadios = document.querySelectorAll('input[name="tier_override"]');
  overrideRadios.forEach(r => { r.checked = (r.value === tier); });

  document.getElementById('vsTierResult').hidden = false;
}

// ─── TIER OVERRIDE ───────────────────────────────────────────────────────────
document.querySelectorAll('input[name="tier_override"]').forEach(radio => {
  radio.addEventListener('change', () => {
    state.tier_override = radio.value;
    state.tier = radio.value;
  });
});

// ─── QUESTION ASSEMBLY ───────────────────────────────────────────────────────
function assembleQuestions() {
  const tier = state.tier;
  const phiAccess = state.phi_access === 'yes' || state.phi_access === 'unsure';
  const isCloud = state.deployment === 'cloud' || state.deployment === 'hybrid';

  return LIBRARY.questions.filter(q => {
    if (!q.tiers.includes(tier)) return false;
    if (q.domain === 'hipaa_specific' && !phiAccess) return false;
    if (q.hipaa && !phiAccess) return false;
    return true;
  });
}

// ─── PREVIEW RENDER ──────────────────────────────────────────────────────────
function renderPreview() {
  const qs = assembleQuestions();
  const assessmentDate = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
  const tierLabels = { lite: 'Lite', standard: 'Standard', hipaa_full: 'HIPAA Full' };
  const tierLabel = tierLabels[state.tier];

  // Update meta
  document.getElementById('vsPreviewTitle').textContent =
    'Vendor Security Questionnaire — ' + (state.vendor_name || 'Vendor');
  document.getElementById('vsPreviewMeta').textContent =
    tierLabel + ' Tier · ' + qs.length + ' Questions · Prepared ' + assessmentDate;

  // Summary card
  const phiAccess = state.phi_access === 'yes' || state.phi_access === 'unsure';
  const tierColors = { lite: 'var(--green)', standard: 'var(--green-mid)', hipaa_full: 'var(--gold)' };
  document.getElementById('vsSummaryTierBadge').textContent = tierLabel + ' Tier';
  document.getElementById('vsSummaryTierBadge').style.color = tierColors[state.tier];

  const summaryBody = document.getElementById('vsSummaryBody');
  const domainCount = [...new Set(qs.map(q => q.domain))].length;
  const baaNote = phiAccess ? '⚠ BAA required — confirm with legal team before sharing PHI.' : '';

  summaryBody.innerHTML = '<dl>' +
    '<dt>Organization</dt><dd>' + (state.org_name || '—') + '</dd>' +
    '<dt>Vendor</dt><dd>' + (state.vendor_name || '—') + '</dd>' +
    '<dt>Assessment type</dt><dd>' + ({new_vendor:'New vendor review',renewal:'Contract renewal',periodic:'Periodic reassessment'}[state.assessment_type] || '—') + '</dd>' +
    '<dt>Risk tier</dt><dd>' + tierLabel + '</dd>' +
    '<dt>Questions included</dt><dd>' + qs.length + ' across ' + domainCount + ' domains</dd>' +
    '<dt>PHI access</dt><dd>' + (phiAccess ? 'Yes — HIPAA Full review required' : 'No') + '</dd>' +
    (state.next_review_date ? '<dt>Next review</dt><dd>' + state.next_review_date + '</dd>' : '') +
    '</dl>' +
    (baaNote ? '<p style="margin-top:12px;font-weight:500;color:var(--gold);">' + baaNote + '</p>' : '');

  // Build document
  const doc = document.getElementById('vsDoc');
  let html = '';

  // Cover
  const responseDate = state.review_date ? 'Response requested by: ' + state.review_date : '';
  html += '<div class="vs-doc-cover">' +
    '<p class="vs-doc-cover-eyebrow">Vendor Security Questionnaire — ' + tierLabel + ' Tier</p>' +
    '<p class="vs-doc-cover-title">' + (state.org_name || 'Your Organization') + '</p>' +
    '<p class="vs-doc-cover-vendor">Re: ' + (state.vendor_name || 'Vendor') + '</p>' +
    '<div class="vs-doc-cover-meta">' +
    '<div class="vs-doc-cover-meta-item"><span class="vs-doc-cover-meta-label">Prepared by</span><span class="vs-doc-cover-meta-val">' + (state.contact_name || '—') + '</span></div>' +
    '<div class="vs-doc-cover-meta-item"><span class="vs-doc-cover-meta-label">Date</span><span class="vs-doc-cover-meta-val">' + assessmentDate + '</span></div>' +
    (responseDate ? '<div class="vs-doc-cover-meta-item"><span class="vs-doc-cover-meta-label">Response deadline</span><span class="vs-doc-cover-meta-val">' + state.review_date + '</span></div>' : '') +
    '<div class="vs-doc-cover-meta-item"><span class="vs-doc-cover-meta-label">Framework basis</span><span class="vs-doc-cover-meta-val">SIG · CAIQ · VSA · HIPAA</span></div>' +
    '</div>' +
    '</div>';

  // Group by domain
  const domainOrder = LIBRARY.domains.map(d => d.id);
  const grouped = {};
  qs.forEach(q => {
    if (!grouped[q.domain]) grouped[q.domain] = [];
    grouped[q.domain].push(q);
  });

  let globalQNum = 1;

  domainOrder.forEach(domainId => {
    if (!grouped[domainId]) return;
    const domainDef = LIBRARY.domains.find(d => d.id === domainId);
    const domainLabel = domainDef ? domainDef.label : domainId;
    const domainQs = grouped[domainId];

    html += '<div class="vs-doc-domain">' +
      '<div class="vs-doc-domain-header">' +
      '<span class="vs-doc-domain-num mono">§' + String(domainDef.order).padStart(2,'0') + '</span>' +
      '<h3 class="vs-doc-domain-title">' + domainLabel + '</h3>' +
      '</div>';

    domainQs.forEach(q => {
      const isHipaa = q.hipaa || q.domain === 'hipaa_specific';
      const hipaaFlag = isHipaa ? '<span class="vs-doc-hipaa-flag"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> HIPAA</span>' : '';

      html += '<div class="vs-doc-question">' +
        '<p class="vs-doc-q-num mono">' + String(globalQNum).padStart(2,'0') + hipaaFlag + '</p>' +
        '<p class="vs-doc-q-text">' + q.text + '</p>';

      if (state.include_notes && q.helper) {
        html += '<p class="vs-doc-q-helper">' + q.helper + '</p>';
      }

      if (state.evidence_prompts && q.evidence) {
        html += '<p class="vs-doc-q-evidence">' + q.evidence + '</p>';
      }

      if (state.include_response_col) {
        if (q.type === 'yes_no') {
          html += '<div style="display:flex;gap:24px;margin-top:8px;">' +
            '<label style="display:flex;align-items:center;gap:6px;font-size:var(--text-sm);cursor:pointer;"><input type="radio" name="ans_' + q.id + '" value="yes" style="accent-color:var(--fg);"> Yes</label>' +
            '<label style="display:flex;align-items:center;gap:6px;font-size:var(--text-sm);cursor:pointer;"><input type="radio" name="ans_' + q.id + '" value="no" style="accent-color:var(--fg);"> No</label>' +
            '<label style="display:flex;align-items:center;gap:6px;font-size:var(--text-sm);cursor:pointer;"><input type="radio" name="ans_' + q.id + '" value="na" style="accent-color:var(--fg);"> N/A</label>' +
            '</div><p class="vs-doc-response">Additional comments or evidence:</p>';
        } else {
          html += '<p class="vs-doc-response">Vendor response:</p>';
        }
      }

      html += '</div>';
      globalQNum++;
    });

    html += '</div>';
  });

  // Closing note
  html += '<div style="margin-top:40px;padding:16px 20px;border:1px solid var(--border);border-radius:var(--r-sm);font-size:var(--text-sm);color:var(--text-muted);line-height:var(--lh-body);">' +
    '<strong style="color:var(--fg);">About this questionnaire.</strong> This questionnaire was assembled using a question library based on SIG, CSA CAIQ, VSA, and HIPAA Security Rule frameworks. It is intended to support vendor due diligence and is not a guarantee of compliance. Organizations should review vendor responses with their security, legal, or compliance team as appropriate.' +
    (phiAccess ? ' Vendors that access PHI must sign a Business Associate Agreement before PHI is shared.' : '') +
    '</div>';

  if (state.next_review_date) {
    html += '<div style="margin-top:16px;padding:12px 16px;background:var(--bg-subtle);border:1px solid var(--border);border-radius:var(--r-sm);font-size:var(--text-sm);color:var(--text-muted);font-family:var(--font-mono);">Next reassessment date: ' + state.next_review_date + '</div>';
  }

  doc.innerHTML = html;
}

// ─── EMAIL DELIVERY ──────────────────────────────────────────────────────────
async function sendEmail() {
  const email = state.email_delivery || state.email;
  if (!email) return;

  const qs = assembleQuestions();
  const tierLabels = { lite: 'Lite', standard: 'Standard', hipaa_full: 'HIPAA Full' };

  try {
    await fetch('https://proactivepixels-router.aqua-noriega.workers.dev/vendor-questionnaire', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        to: email,
        org_name: state.org_name,
        vendor_name: state.vendor_name,
        tier: tierLabels[state.tier],
        question_count: qs.length,
        contact_name: state.contact_name,
      })
    });
  } catch(e) {
    // Fail silently — email delivery is Phase C
    console.warn('Email delivery not yet active:', e.message);
  }
}

// ─── TRACKING: suppress Pixel during form steps ──────────────────────────────
function suppressPixel() {
  if (window.fbq) {
    window._fbqSuppressed = true;
  }
}
function restorePixel() {
  window._fbqSuppressed = false;
}

// ─── INITIALIZATION ──────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {

  // Suppress Meta Pixel while wizard is active
  suppressPixel();

  // Text fields — Step 1
  setupTextField('vsOrgName',      'org_name');
  setupTextField('vsContactName',  'contact_name');
  setupTextField('vsEmail',        'email');
  setupTextField('vsReviewDate',   'review_date');
  setupOptionGroup('vsAssessmentType', 'assessment_type');

  // Text fields — Step 2
  setupTextField('vsVendorName', 'vendor_name');
  setupOptionGroup('vsVendorCategory',   'vendor_category');
  setupOptionGroup('vsDeployment',       'deployment');
  setupOptionGroup('vsStoresData',       'stores_data');
  setupOptionGroup('vsConnectsInternal', 'connects_internal');

  // Step 3
  setupOptionGroup('vsPhiAccess',          'phi_access',          onPhiChange);
  setupOptionGroup('vsBaaExpected',        'baa_expected');
  setupOptionGroup('vsHasSubcontractors',  'has_subcontractors');
  setupOptionGroup('vsRegulatedFinancial', 'regulated_financial');

  // Step 4
  setupOptionGroup('vsOpCritical',       'operationally_critical');
  setupOptionGroup('vsDowntimeImpact',   'downtime_impact');
  setupOptionGroup('vsPrivilegedAccess', 'privileged_access');

  // Step 5 toggles
  document.getElementById('vsIncludeNotes').addEventListener('change', function() { state.include_notes = this.checked; });
  document.getElementById('vsIncludeResponseCol').addEventListener('change', function() { state.include_response_col = this.checked; });
  document.getElementById('vsIncludeEvidence').addEventListener('change', function() { state.evidence_prompts = this.checked; });
  setupTextField('vsNextReview',    'next_review_date');
  setupTextField('vsEmailDelivery', 'email_delivery');
  document.getElementById('vsSaveProfile').addEventListener('change', function() { state.save_profile = this.checked; });

  // Navigation
  document.getElementById('vsNext1').addEventListener('click', () => { if (state.org_name && state.contact_name && state.email && state.assessment_type) goToStep(2); });
  document.getElementById('vsNext2').addEventListener('click', () => { if (state.vendor_name && state.vendor_category && state.deployment && state.stores_data && state.connects_internal) goToStep(3); });
  document.getElementById('vsNext3').addEventListener('click', () => { if (state.phi_access && state.baa_expected && state.has_subcontractors && state.regulated_financial) goToStep(4); });
  document.getElementById('vsNext4').addEventListener('click', () => { if (state.operationally_critical && state.downtime_impact && state.privileged_access) goToStep(5); });

  document.getElementById('vsBack2').addEventListener('click', () => goToStep(1));
  document.getElementById('vsBack3').addEventListener('click', () => goToStep(2));
  document.getElementById('vsBack4').addEventListener('click', () => goToStep(3));
  document.getElementById('vsBack5').addEventListener('click', () => goToStep(4));

  // Generate
  document.getElementById('vsGenerate').addEventListener('click', () => {
    renderPreview();

    // Show email send button if email provided
    const emailDelivery = document.getElementById('vsEmailDelivery').value;
    if (emailDelivery) {
      document.getElementById('vsEmailBtn').style.display = '';
    }

    // Show preview, scroll to it
    const previewSection = document.getElementById('vs-preview');
    previewSection.hidden = false;
    previewSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

    // Restore pixel now that wizard is done and data has left DOM
    restorePixel();
    if (window.fbq) fbq('track', 'Lead');
  });

  // Print
  document.getElementById('vsPrintBtn').addEventListener('click', () => { window.print(); });

  // Email send
  document.getElementById('vsEmailBtn').addEventListener('click', () => { sendEmail(); });

  // Restart
  document.getElementById('vsRestartBtn').addEventListener('click', () => {
    location.reload();
  });

  // Fire ViewContent on page load (safe — no user data)
  if (window.fbq) fbq('track', 'ViewContent');
});
</script>
