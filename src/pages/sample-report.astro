        <span class="tools-summary-value">$176 <span class="cost-unit">/mo · $2,112/yr</span></span>
      </div>
      <div class="tools-summary-row">
        <span class="tools-summary-label">Estimated staff hours recovered weekly</span>
        <span class="tools-summary-value">15–22 hrs <span class="cost-unit">/week</span></span>
      </div>
      <div class="tools-summary-row">
        <span class="tools-summary-label">Annual value at blended staff rate ($19.20/hr)</span>
        <span class="tools-summary-value">$14,976–$21,965 <span class="cost-unit">/yr</span></span>
      </div>
      <div class="tools-summary-row tools-summary-roi">
        <span class="tools-summary-label">Net annual ROI after platform costs</span>
