  <!-- NEXT STEPS -->
  <div class="next-section animate-in" style="animation-delay:.45s">
    <div class="section-label">Next Steps</div>
    <h2 class="section-h2">This assessment is yours. Here is what happens if you want to go further.</h2>
    <p class="section-body">You are under no obligation to do anything with this document. Share it with your board, your operations team, or your funders. It stands alone.</p>

    <div class="step-list">
