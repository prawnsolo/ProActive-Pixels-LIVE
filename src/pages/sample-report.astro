---
// sample-report.astro — standalone page, no shared nav/footer
// Uses ProActive Pixels brand identity (Instrument Serif, Satoshi, blue/navy palette)
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Operations Assessment: Piedmont Free Clinic | ProActive Pixels</title>
<meta name="description" content="Sample Operations Assessment from ProActive Pixels. See how we identify admin bottlenecks and recoverable capacity for HIPAA-regulated nonprofits." />
<link rel="canonical" href="https://proactivepixels.com/sample-report" />

<!-- Open Graph -->
<meta property="og:title" content="Operations Assessment: Piedmont Free Clinic | ProActive Pixels" />
<meta property="og:description" content="Sample Operations Assessment from ProActive Pixels. 390 clinical hours lost annually to no-shows, and how to recover them." />
<meta property="og:url" content="https://proactivepixels.com/sample-report" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="ProActive Pixels" />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" />

<!-- Fonts -->
<link rel="dns-prefetch" href="https://fonts.googleapis.com">
<link rel="dns-prefetch" href="https://fonts.gstatic.com">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600&display=swap" rel="stylesheet">

<style>
/* ── RESET ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

/* ── DESIGN TOKENS (OKLCH) ── */
:root {
  /* PP Brand blue/navy palette (variable names preserved for compatibility) */
  --forest:        #171E62;                          /* Brand navy — cover + key accents */
  --forest-mid:    oklch(30% 0.10 244);              /* Deep navy mid */
  --moss:          oklch(49% 0.12 244);              /* Cornflower Ocean #1770B2 */
  --sage:          oklch(67% 0.10 228);              /* Fresh Sky #40A5DD */
  --sage-pale:     oklch(95% 0.015 252);             /* Sky pale */

  /* Cool porcelain surface */
  --cream:         oklch(97.5% 0.006 252);           /* Porcelain #F4F7FB */
  --cream-deep:    oklch(94% 0.008 252);             /* Slightly deeper cool surface */
  --ink:           oklch(18% 0.012 78);
  --ink-muted:     oklch(46% 0.018 78);
  --ink-faint:     oklch(62% 0.014 78);

  /* Gold — healthcare trust signal */
  --gold:          oklch(72% 0.12 78);
  --gold-pale:     oklch(95% 0.04 78);

  /* Alert */
  --red:           oklch(52% 0.15 25);
  --red-pale:      oklch(96% 0.02 25);

  /* Border */
  --border:        oklch(89% 0.008 252);
  --border-strong: oklch(81% 0.010 252);

  --font-serif: 'Instrument Serif', Georgia, serif;
  --font-sans:  'Satoshi', system-ui, sans-serif;
  --font-mono:  'JetBrains Mono', monospace;
}

body {
  background: var(--cream-deep);
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  font-optical-sizing: auto;
}

/* ── BACK BAR ── */
.back-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(23, 30, 98, 0.94);
  backdrop-filter: blur(8px) saturate(160%);
  -webkit-backdrop-filter: blur(8px) saturate(160%);
  padding: 0 24px;
  border-bottom: 1px solid oklch(100% 0 0 / .06);
}

.back-bar a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: oklch(100% 0 0 / .45);
  text-decoration: none;
  padding: 14px 0;
  transition: color 0.2s;
}

.back-bar a:hover { color: oklch(100% 0 0 / .75); }

.back-bar a svg {
  width: 12px;
  height: 12px;
  stroke: currentColor;
  stroke-width: 2;
  fill: none;
}

/* ── PAGE WRAPPER ── */
.report-page {
  padding: 40px 24px 80px;
}

/* ── OUTER SHELL ── */
.report-shell {
  max-width: 900px;
  margin: 0 auto;
  background: var(--cream);
  box-shadow: 0 0 0 1px var(--border), 0 32px 80px oklch(0% 0 0 / .08);
  position: relative;
  overflow: hidden;
}

/* ── COVER ── */
.cover {
  background: var(--forest);
  padding: 64px 64px 56px;
  position: relative;
  overflow: hidden;
  min-height: 320px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* Grain overlay on cover */
.cover::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  opacity: 0.04;
  pointer-events: none;
}

/* Diagonal geometric accent */
.cover::after {
  content: '';
  position: absolute;
  top: -60px;
  right: -60px;
  width: 320px;
  height: 320px;
  border: 1px solid oklch(100% 0 0 / .06);
  transform: rotate(22deg);
  pointer-events: none;
}

.cover-eyebrow {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: oklch(100% 0 0 / .35);
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  gap: 12px;
}
.cover-eyebrow::before {
  content: '';
  display: block;
  width: 24px;
  height: 1px;
  background: var(--sage);
  margin-top: 4px;
}

.cover-body {
  position: relative;
  z-index: 1;
}

.cover-headline {
  font-family: var(--font-serif);
  font-size: clamp(2.8rem, 6vw, 4.5rem);
  font-weight: 700;
  line-height: 0.95;
  letter-spacing: -0.02em;
  color: oklch(98% 0.004 252);
  margin-bottom: 8px;
  text-wrap: balance;
}

.cover-sub {
  font-family: var(--font-serif);
  font-size: clamp(2.8rem, 6vw, 4.5rem);
  font-weight: 400;
  font-style: italic;
  line-height: 0.95;
  letter-spacing: -0.02em;
  color: var(--sage);
}

.cover-meta {
  margin-top: 36px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
}

.cover-org {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-style: italic;
  color: oklch(100% 0 0 / .55);
}

.cover-date {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: oklch(100% 0 0 / .40);
}

/* ── SECTION SCAFFOLDING ── */
.section {
  padding: 56px 64px;
  border-bottom: 1px solid var(--border);
}

.section:last-child { border-bottom: none; }

.section-label {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--moss);
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.section-label::before {
  content: '';
  display: block;
  width: 20px;
  height: 1px;
  background: var(--sage);
}

.section-h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--ink);
  max-width: 56ch;
  text-wrap: balance;
}

.section-h2 em {
  font-style: italic;
  color: var(--ink-muted);
}

.section-body {
  font-size: 1rem;
  line-height: 1.8;
  color: var(--ink-muted);
  max-width: 62ch;
  margin-top: 16px;
  text-wrap: pretty;
}

/* ── EXECUTIVE SUMMARY ── */
.summary-section {
  background: var(--forest);
  padding: 56px 64px;
  position: relative;
  overflow: hidden;
}

.summary-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  opacity: 0.03;
  pointer-events: none;
}

.summary-section .section-label {
  color: var(--sage);
}

.summary-section .section-label::before { background: var(--sage); }

.summary-lede {
  font-family: var(--font-serif);
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -0.01em;
  color: oklch(98% 0.004 252);
  max-width: 52ch;
  margin-bottom: 24px;
  position: relative;
  z-index: 1;
  text-wrap: balance;
}

.summary-lede em {
  font-style: italic;
  color: var(--sage);
}

.summary-body {
  font-size: 0.95rem;
  line-height: 1.85;
  color: oklch(100% 0 0 / .68);
  max-width: 60ch;
  position: relative;
  z-index: 1;
}

.summary-body p { text-wrap: pretty; }
.summary-body p + p { margin-top: 12px; }

/* ── PRIMARY FINDING — THE HERO SECTION ── */
.finding-section {
  background: var(--cream-deep);
  padding: 56px 64px;
  border-bottom: 1px solid var(--border);
}

.finding-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  margin-top: 40px;
}

.finding-cell {
  background: var(--cream);
  padding: 36px 32px;
  position: relative;
  transition: background 0.25s;
}

.finding-cell:hover { background: oklch(95% 0.012 252); }

.finding-cell::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 3px;
  background: var(--sage);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.finding-cell:hover::before { transform: scaleX(1); }

.finding-value {
  font-family: var(--font-serif);
  font-variant-numeric: tabular-nums;
  font-size: clamp(2.8rem, 5vw, 4rem);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.03em;
  color: var(--forest);
  margin-bottom: 12px;
  display: block;
}

.finding-label {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.4;
  margin-bottom: 8px;
  display: block;
}

.finding-sub {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  letter-spacing: 0.06em;
  color: var(--ink-faint);
  line-height: 1.5;
  display: block;
}

/* ── ALERT BOX ── */
.alert {
  margin-top: 24px;
  border: 1px solid oklch(85% 0.04 25);
  border-top: 3px solid var(--red);
}

.alert-body {
  padding: 20px 24px;
  background: var(--red-pale);
}

.alert-headline {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--red);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 6px;
}

.alert-text {
  font-size: 0.875rem;
  line-height: 1.7;
  color: var(--ink);
}

/* ── COST BREAKDOWN ── */
.cost-section {
  padding: 56px 64px;
  border-bottom: 1px solid var(--border);
}

.cost-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  margin-top: 40px;
}

.metric-block {
  padding: 28px;
  border: 1px solid var(--border);
  background: var(--cream);
  position: relative;
  overflow: hidden;
}

.metric-block::after {
  content: attr(data-num);
  position: absolute;
  bottom: 16px;
  right: 20px;
  font-family: var(--font-serif);
  font-size: 2.8rem;
  font-weight: 700;
  color: var(--border);
  line-height: 1;
  pointer-events: none;
  letter-spacing: -0.04em;
}

.metric-value {
  font-family: var(--font-serif);
  font-variant-numeric: tabular-nums;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--forest);
  line-height: 1;
  margin-bottom: 10px;
}

.metric-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 4px;
}

.metric-sub {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--ink-faint);
  letter-spacing: 0.04em;
  padding-right: 2.8rem;
}

.cost-note {
  margin-top: 28px;
  padding: 20px 24px;
  border-left: 1px solid var(--border-strong);
  font-size: 0.9rem;
  color: var(--ink-muted);
  line-height: 1.75;
}

/* ── RECOMMENDED SOLUTION ── */
.solution-section {
  padding: 56px 64px;
  border-bottom: 1px solid var(--border);
}

.solution-intro {
  font-size: 1.05rem;
  text-wrap: pretty;
  line-height: 1.8;
  color: var(--ink-muted);
  max-width: 60ch;
  margin-top: 16px;
  margin-bottom: 40px;
}

.checklist {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid var(--border);
  margin-bottom: 40px;
}

.check-item {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 18px 24px;
  border-bottom: 1px solid var(--border);
  transition: background 0.2s;
}

.check-item:last-child { border-bottom: none; }
.check-item:hover { background: var(--sage-pale); }

.check-mark {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--forest);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
}

.check-mark svg {
  width: 10px;
  height: 10px;
  stroke: var(--cream);
  stroke-width: 2.5;
  fill: none;
}

.check-text {
  font-size: 0.9375rem;
  color: var(--ink);
  line-height: 1.5;
}

.check-text strong {
  font-weight: 600;
  color: var(--ink);
}

/* Impact stats — dark strip */
.impact-strip {
  background: var(--forest);
  margin: 0 -64px;
  padding: 40px 64px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  position: relative;
  overflow: hidden;
}

.impact-strip::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  opacity: 0.03;
  pointer-events: none;
}

.impact-cell {
  padding: 28px 32px;
  border-right: 1px solid oklch(100% 0 0 / .08);
  position: relative;
  z-index: 1;
}

.impact-cell:last-child { border-right: none; }

.impact-value {
  font-family: var(--font-serif);
  font-variant-numeric: tabular-nums;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--sage);
  line-height: 1;
  margin-bottom: 8px;
}

.impact-label {
  font-size: 0.825rem;
  color: oklch(100% 0 0 / .68);
  line-height: 1.5;
}

.impact-label strong {
  color: oklch(100% 0 0 / .8);
  font-weight: 500;
}

/* ── ADDITIONAL OPPORTUNITIES ── */
.opps-section {
  padding: 56px 64px;
  border-bottom: 1px solid var(--border);
}

.opp-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-top: 36px;
  border: 1px solid var(--border);
}

.opp-item {
  display: grid;
  grid-template-columns: 56px 1fr;
  border-bottom: 1px solid var(--border);
  transition: background 0.2s;
}

.opp-item:last-child { border-bottom: none; }
.opp-item:hover { background: var(--cream-deep); }

.opp-num {
  background: var(--forest-mid);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-serif);
  font-size: 1.4rem;
  font-weight: 600;
  color: oklch(100% 0 0 / .55);
  border-right: 1px solid oklch(100% 0 0 / .08);
  padding: 24px 0;
}

.opp-body {
  padding: 20px 24px;
}

.opp-title {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 6px;
}

.opp-desc {
  font-size: 0.85rem;
  color: var(--ink-muted);
  line-height: 1.65;
  margin-bottom: 10px;
}

.opp-meta {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.08em;
  color: var(--ink-faint);
  text-transform: uppercase;
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.opp-meta span {
  display: flex;
  align-items: center;
  gap: 6px;
}

.opp-meta span::before {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--sage);
  flex-shrink: 0;
}

/* ── PACE SECTION ── */
.pace-section {
  padding: 56px 64px;
  border-bottom: 1px solid var(--border);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: start;
}

.pace-left .section-h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); }

.pace-body {
  font-size: 0.9375rem;
  line-height: 1.8;
  color: var(--ink-muted);
  margin-top: 16px;
}

.pace-body p { text-wrap: pretty; }
.pace-body p + p { margin-top: 12px; }

.phase-table {
  border: 1px solid var(--border);
  width: 100%;
}

.phase-row {
  display: grid;
  grid-template-columns: 48px 1fr;
  border-bottom: 1px solid var(--border);
}

.phase-row:last-child { border-bottom: none; }

.phase-num {
  background: var(--cream-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--moss);
  border-right: 1px solid var(--border);
  padding: 16px 0;
}

.phase-body {
  padding: 14px 16px;
}

.phase-title {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 2px;
}

.phase-time {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  letter-spacing: 0.06em;
  color: var(--ink-faint);
  text-transform: uppercase;
  margin-bottom: 4px;
}

.phase-desc {
  font-size: 0.78rem;
  color: var(--ink-muted);
  line-height: 1.6;
}

/* ── SECURITY ── */
.security-section {
  padding: 56px 64px;
  border-bottom: 1px solid var(--border);
  background: var(--cream-deep);
}

.cert-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 28px;
  margin-bottom: 36px;
}

.cert {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 6px 12px;
  border: 1px solid var(--border-strong);
  color: var(--ink-muted);
  background: var(--cream);
}

.cert.hipaa {
  border-color: oklch(72% 0.12 78 / .5);
  color: oklch(50% 0.10 78);
  background: var(--gold-pale);
}

.sec-grid {
  display: flex;
  flex-direction: column;
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
}

.sec-cell {
  background: var(--cream);
  padding: 24px;
}

/* HIPAA lead card — full-width, dark background */
.sec-cell--lead {
  background: var(--forest);
  padding: 32px;
}

.sec-cell--lead .sec-title {
  color: oklch(98% 0.004 252);
  font-size: 1rem;
  margin-bottom: 8px;
}

.sec-cell--lead .sec-desc {
  color: oklch(100% 0 0 / .65);
  font-size: 0.875rem;
}

/* Subordinate three-cell row */
.sec-sub {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 1px;
  background: var(--border);
}

.sec-title {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 6px;
}

.sec-desc {
  font-size: 0.825rem;
  color: var(--ink-muted);
  line-height: 1.65;
