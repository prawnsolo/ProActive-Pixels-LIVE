---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = 'ProActive Pixels | Capacity Reviews for HIPAA Nonprofits',
  description = 'We find where your staff hours are going and help get them back. Free Capacity Review. Operations Assessment in 24 hours. HIPAA compliant.',
  canonical = 'https://proactivepixels.com',
  ogImage = 'https://proactivepixels.com/og-image.png',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- ═══ GOOGLE TAG MANAGER ═══════════════════════════════════════
    Replace GTM-XXXXXXX with your GTM Container ID.
    Get it at: https://tagmanager.google.com
  ══════════════════════════════════════════════════════════════════ -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-XXXXXXX');</script>
  <!-- ═══ END GOOGLE TAG MANAGER ═════════════════════════════════ -->


  <!-- Core SEO -->
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <link rel="canonical" href={canonical}>

  <!-- Theme -->
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F4F7FB">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171E62">
  <meta name="color-scheme" content="light dark">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="ProActive Pixels">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="ProActive Pixels — Capacity Reviews for HIPAA Nonprofits">

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@proactivepixels">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content="ProActive Pixels — Capacity Reviews for HIPAA Nonprofits">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Fonts -->
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://fonts.gstatic.com">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600&display=swap" rel="stylesheet">

  <!-- JSON-LD: Organization + ProfessionalService -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["ProfessionalService", "LocalBusiness"],
        "@id": "https://proactivepixels.com/#organization",
        "name": "ProActive Pixels",
        "url": "https://proactivepixels.com",
        "logo": "https://proactivepixels.com/favicon.svg",
        "image": "https://proactivepixels.com/og-image.png",
        "description": "AI consulting agency serving HIPAA-regulated nonprofits. Free Capacity Reviews and Operations Assessments for free clinics, behavioral health organizations, and community health centers.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Orange",
          "addressRegion": "VA",
          "postalCode": "22960",
          "addressCountry": "US"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "38.2454",
          "longitude": "-78.1097"
        },
        "telephone": "+1-540-600-0080",
        "email": "solutions@proactivepixels.com",
        "areaServed": [
          "Charlottesville, VA",
          "Culpeper, VA",
          "Fredericksburg, VA",
          "Richmond, VA",
          "Harrisonburg, VA",
          "Orange, VA"
        ],
        "serviceType": "AI Workflow Automation for HIPAA Nonprofits",
        "knowsAbout": ["HIPAA compliance", "nonprofit operations", "AI automation", "workflow optimization"],
        "sameAs": [
          "https://linkedin.com/company/proactivepixels"
        ]
      },
      {
        "@type": "Service",
        "@id": "https://proactivepixels.com/#capacity-review",
        "name": "Capacity Review",
        "provider": { "@id": "https://proactivepixels.com/#organization" },
        "description": "Free 8–12 minute voice assessment that identifies your three biggest admin bottlenecks. Conducted by Alex, our AI intake assistant. Operations Assessment delivered within 24 hours.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock"
        },
        "serviceType": "Operations Assessment",
        "audience": {
          "@type": "Audience",
          "audienceType": "HIPAA-regulated nonprofits"
        }
      }
    ]
  }
  </script>
</head>
<body>
  <!-- ═══ GTM NOSCRIPT ════════════════════════════════════════════
    Place immediately after <body> opening tag. Replace GTM-XXXXXXX.
  ══════════════════════════════════════════════════════════════════ -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-XXXXXXX"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- ═══ END GTM NOSCRIPT ════════════════════════════════════════ -->

  <slot />
</body>
</html>
