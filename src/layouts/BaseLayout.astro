---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = 'Your Staff Hours Belong to Your Mission | ProActive Pixels',
  description = "Your staff didn't get into this work to fill out forms. We find where the hours go: intake, scheduling, follow-up, grant reporting. We help automate the specific tasks so those hours go back to the people you serve.",
  canonical = 'https://proactivepixels.com',
  ogImage = 'https://proactivepixels.com/og-image.png',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- ═══ ANALYTICS PII GUARD ════════════════════════════════════
    Wraps dataLayer.push to strip known PII fields before any GTM tag
    can read them. Runs before GTM loads so the wrapper is in place
    from the first push. Protects the Capacity Review form intake.
    Fields covered: email, phone, first_name, org_name, name.
  ══════════════════════════════════════════════════════════════════ -->
  <script>
  (function() {
    var dl = window.dataLayer = window.dataLayer || [];
    var _pii = ['email', 'phone', 'first_name', 'org_name', 'name'];
    var _orig = dl.push.bind(dl);
    dl.push = function() {
      var args = Array.prototype.slice.call(arguments);
      args.forEach(function(ev) {
        if (ev && typeof ev === 'object' && !Array.isArray(ev)) {
          _pii.forEach(function(k) { delete ev[k]; });
        }
      });
      return _orig.apply(null, args);
    };
  })();
  </script>
  <!-- ═══ END ANALYTICS PII GUARD ═════════════════════════════════ -->

  <!-- ═══ GOOGLE TAG MANAGER ═══════════════════════════════════════
    Replace GTM-NB4ZPLTL with your GTM Container ID.
    Get it at: https://tagmanager.google.com
  ══════════════════════════════════════════════════════════════════ -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-NB4ZPLTL');</script>
  <!-- ═══ END GOOGLE TAG MANAGER ═════════════════════════════════ -->


  <!-- Core SEO -->
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <link rel="canonical" href={canonical}>

  <!-- Theme -->
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F4F7FB">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171E62">
  <meta name="color-scheme" content="light dark">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="ProActive Pixels">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="ProActive Pixels. Staff hour recovery for nonprofits.">

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@proactivepixels">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content="ProActive Pixels. Staff hour recovery for nonprofits.">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Fonts -->
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://fonts.gstatic.com">
  <link rel="dns-prefetch" href="https://api.fontshare.com">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://api.fontshare.com">
  <!-- Instrument Serif: self-hosted — eliminates external round trip for the LCP font.
       Preloads start the WOFF2 download immediately alongside the HTML. -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/instrument-serif-latin-normal.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/instrument-serif-latin-italic.woff2" crossorigin>
  <style>
    @font-face {
      font-family: 'Instrument Serif';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url('/fonts/instrument-serif-latin-normal.woff2') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
                     U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
                     U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: 'Instrument Serif';
      font-style: italic;
      font-weight: 400;
      font-display: swap;
      src: url('/fonts/instrument-serif-latin-italic.woff2') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
                     U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
                     U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
  </style>
  <!-- JetBrains Mono: non-blocking (code/mono only, not LCP-critical) -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" onload="this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"></noscript>
  <!-- Satoshi: non-blocking via Fontshare (body font) -->
  <link rel="preload" as="style" href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600&display=swap" onload="this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600&display=swap"></noscript>

  <!-- JSON-LD: Organization + ProfessionalService -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["ProfessionalService", "LocalBusiness"],
        "@id": "https://proactivepixels.com/#organization",
        "name": "ProActive Pixels",
        "url": "https://proactivepixels.com",
        "logo": "https://proactivepixels.com/favicon.svg",
        "image": "https://proactivepixels.com/og-image.png",
        "description": "We help nonprofits find where staff hours are going and get them back to program delivery. Operations assessments for free clinics, behavioral health organizations, and community health centers.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Orange",
          "addressRegion": "VA",
          "postalCode": "22960",
          "addressCountry": "US"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "38.2454",
          "longitude": "-78.1097"
        },
        "telephone": "+1-540-600-0080",
        "email": "solutions@proactivepixels.com",
        "areaServed": [
          "Charlottesville, VA",
          "Culpeper, VA",
          "Fredericksburg, VA",
          "Richmond, VA",
          "Harrisonburg, VA",
          "Orange, VA"
        ],
        "serviceType": "Admin Workflow Automation for Nonprofits",
        "knowsAbout": ["HIPAA compliance", "nonprofit operations", "AI automation", "workflow optimization"],
        "sameAs": [
          "https://linkedin.com/company/proactivepixels"
        ]
      },
      {
        "@type": "Service",
        "@id": "https://proactivepixels.com/#capacity-review",
        "name": "Capacity Review",
        "provider": { "@id": "https://proactivepixels.com/#organization" },
        "description": "Free 8–12 minute voice assessment that identifies your three biggest admin bottlenecks. Conducted by Alex, our AI intake assistant. Operations Assessment delivered within 24 hours.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock"
        },
        "serviceType": "Operations Assessment",
        "audience": {
          "@type": "Audience",
          "audienceType": "HIPAA-regulated nonprofits"
        }
      }
    ]
  }
  </script>
</head>
<body>
  <!-- ═══ GTM NOSCRIPT ════════════════════════════════════════════
    Place immediately after <body> opening tag. Replace GTM-NB4ZPLTL.
  ══════════════════════════════════════════════════════════════════ -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NB4ZPLTL"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- ═══ END GTM NOSCRIPT ════════════════════════════════════════ -->

  <slot />
</body>
</html>
